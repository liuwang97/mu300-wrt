of: reserved_mem: reserve ranges the device tree forgot

The 6.18 counterpart of kernel/patches/of-reserved-mem-add.patch. The F50's audio DSP cannot start because
/audio-mem-mgr has no memory-region: every other audio address is in that node (cmdaddr, smsg-addr,
shmaddr-dsp-vbc, the IRAM bases), and the reservation is missing. CONFIG_OF_RESERVED_MEM_ADD (or
reserved_mem_add= on the command line) is a list of base,size pairs reserved as though the device tree had asked
for them, so the memory stays out of Linux's hands and the DSP can be loaded into it (FINDINGS 24, 188). The
ranges keep their struct pages, as on 5.4: audio_mem maps them non-cached with vmap(), as the modem's smem does.

diff -ruN a/drivers/of/Kconfig b/drivers/of/Kconfig
--- a/drivers/of/Kconfig
+++ b/drivers/of/Kconfig
@@ -108,6 +108,16 @@
 	  are not reserved, so the memory stays available to Linux. Can be
 	  overridden with reserved_mem_skip= on the command line.
 
+config OF_RESERVED_MEM_ADD
+	string "Extra memory ranges to reserve"
+	depends on OF_RESERVED_MEM
+	default ""
+	help
+	  Semicolon separated base,size pairs (memparse syntax, so 0xaf700000,3M
+	  works) reserved as though /reserved-memory had listed them: for memory
+	  a device needs and the device tree does not reserve. Can be overridden
+	  with reserved_mem_add= on the command line.
+
 config OF_RESOLVE
 	bool
 
diff -ruN a/drivers/of/fdt.c b/drivers/of/fdt.c
--- a/drivers/of/fdt.c
+++ b/drivers/of/fdt.c
@@ -487,6 +487,45 @@
 		elfcorehdr_size >> 10, elfcorehdr_addr);
 }
 
+static char reserved_mem_add[128] __initdata = CONFIG_OF_RESERVED_MEM_ADD;
+
+static int __init reserved_mem_add_setup(char *str)
+{
+	strscpy(reserved_mem_add, str, sizeof(reserved_mem_add));
+	return 0;
+}
+early_param("reserved_mem_add", reserved_mem_add_setup);
+
+/* "base,size;base,size": reserve each pair as if the device tree had asked */
+static void __init reserved_mem_add_regions(void)
+{
+	char *p = reserved_mem_add;
+
+	while (*p) {
+		phys_addr_t base, size;
+		char *next;
+
+		base = memparse(p, &next);
+		if (next == p || *next != ',')
+			break;
+		p = next + 1;
+		size = memparse(p, &next);
+		if (next == p)
+			break;
+		p = next;
+		if (*p == ';')
+			p++;
+		if (!size)
+			continue;
+		if (memblock_is_region_reserved(base, size) || memblock_reserve(base, size))
+			pr_err("Reserved memory: failed to reserve %pa size %pa (reserved_mem_add)\n",
+			       &base, &size);
+		else
+			pr_info("Reserved memory: reserved %pa size %pa (reserved_mem_add)\n",
+				&base, &size);
+	}
+}
+
 /**
  * early_init_fdt_scan_reserved_mem() - create reserved memory regions
  *
@@ -505,6 +544,7 @@
 
 	fdt_reserve_elfcorehdr();
 	fdt_scan_reserved_mem();
+	reserved_mem_add_regions();
 
 	/* Process header /memreserve/ fields */
 	for (n = 0; ; n++) {

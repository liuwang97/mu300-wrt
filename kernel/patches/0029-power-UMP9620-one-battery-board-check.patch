--- a/include/linux/power/ump9620-battery.h
+++ b/include/linux/power/ump9620-battery.h
@@ -0,0 +1,22 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_POWER_UMP9620_BATTERY_H
+#define _LINUX_POWER_UMP9620_BATTERY_H
+
+#include <linux/of.h>
+
+/*
+ * The UMP9620 boards share one device tree layout: the F50 carries the charger, fuel gauge and USB-PD nodes too,
+ * without a battery. Only the board with a battery (the ZTE U30 Air) has the stock charger policy service, and it
+ * is enabled there. Ask this before any register access: a charger that answers at its address is no proof of a
+ * battery (the F50 has one at 0x1a, which, bound and told to charge, had the PMIC reset the board).
+ */
+static inline bool ump9620_has_battery_policy(void)
+{
+	struct device_node *policy = of_find_node_by_path("/charger_policy_service");
+	bool enabled = policy && of_device_is_available(policy);
+
+	of_node_put(policy);
+	return enabled;
+}
+
+#endif

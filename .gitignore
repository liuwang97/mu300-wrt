# device dumps, proprietary blobs and build outputs never belong in this repository
dumps/
firmware/
# ...but not the kernel source directory of that name in the port
!kernel/port/drivers/firmware/
android-subset/
out/
release/
work/
work-*/
*.img
*.tar
*.tar.gz
*.tgz
*.bin
*.ko
busybox
__pycache__/
.DS_Store
logs-*/
# the static programs, built in place by hand (tools/make-release.sh builds them elsewhere)
openwrt/src/logdw/logdw
openwrt/src/bt-init/mu300-bt-init
openwrt/src/keys/mu300-keys
openwrt/src/atd-io/mu300-atd-io
openwrt/src/carry/mu300-carry
# a test run with TMPDIR inside the tree
*/tests/mu300-test-*/
# the release smoke test's boards (tools/smoke.py; tools/smoke.example.json is the example)
/tools/smoke.json

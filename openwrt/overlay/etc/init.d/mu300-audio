#!/bin/sh /etc/rc.common
# The Unisoc sound card: 23 drivers, the DMA engine they need, and a bind to finish the job.
# Only "load" - "start" writes the DSP firmware and reboots this device (see /opt/mu300/bin/mu300-audio-dsp).
START=14
USE_PROCD=1
export PATH="$PATH:/opt/mu300/busybox-bin"

boot() {
	# In the background, like the rest of the hardware bring-up: binding the card takes about half a minute
	# of waiting on probes, and busybox init does not spawn the consoles until sysinit has returned.
	[ -d "/lib/modules/$(uname -r)/audio" ] || return 0
	(/opt/mu300/bin/mu300-audio-dsp load > /tmp/mu300-audio.log 2>&1) &
}

start_service() { :; }

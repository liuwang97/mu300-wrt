#!/bin/sh /etc/rc.common
# apply the CPU performance profile saved by mu300-cpu (/etc/mu300/cpu.conf), and keep the services on the little
# cluster (mu300-cpu services: the default, with or without the file, so the shell daemons leave the big cores asleep)
START=95

start() {
	if [ -r /etc/mu300/cpu.conf ]; then
		/opt/mu300/bin/mu300-cpu apply
	else
		/opt/mu300/bin/mu300-cpu services apply
	fi
}

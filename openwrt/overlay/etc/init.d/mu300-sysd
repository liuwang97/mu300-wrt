#!/bin/sh /etc/rc.common
# The buttons, the LEDs' tick and the thermal guard in one event-driven daemon (/opt/mu300/bin/mu300-sysd, with
# mu300-keys -u reporting the presses and the power_supply and extcon uevents).
START=95
USE_PROCD=1
export PATH="$PATH:/opt/mu300/busybox-bin"

start_service() {
	procd_open_instance sysd
	procd_set_param command /usr/bin/ucode /opt/mu300/bin/mu300-sysd
	procd_set_param env PATH="$PATH"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

#!/bin/sh /etc/rc.common
# keep the modem's AT channel open (closing it wedges the SIPC tty; see /opt/mu300/bin/mu300-atd)
START=91
USE_PROCD=1
export PATH="$PATH:/opt/mu300/busybox-bin"

start_service() {
	[ -c /dev/stty_nr1 ] || return 0
	procd_open_instance atd
	procd_set_param command /opt/mu300/bin/mu300-atd
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

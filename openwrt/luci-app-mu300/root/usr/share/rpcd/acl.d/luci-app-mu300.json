{
 "luci-app-mu300": {
  "description": "MU300 control center: status dashboard, network locks, AT terminal, SMS and VPN",
  "read": {
   "ubus": {
    "mu300dash": [ "sysinfo", "status", "signal", "lock_get", "usb_get", "usb_net_list", "lang_get", "power_get", "ttl_get", "cpu_get", "traffic_get", "ops_log", "packages_get" ],
    "mu300rates": [ "netdev" ],
    "mu300vpn": [ "status", "profiles", "engines", "subscriptions", "settings" ]
   },
   "uci": {
    "unisoc_modem": [ "*" ]
   }
  },
  "write": {
   "ubus": {
    "mu300dash": [ "act", "at", "at_job", "at_history", "lock_set", "sms_list", "sms_show", "sms_send", "sms_job", "sms_delete", "sms_sync", "usb_set", "usb_net_add", "lang_set", "power_set", "ttl_set", "forward_get", "forward_set", "forward_test", "cpu_set", "traffic_set", "packages_act" ],
    "mu300vpn": [ "job", "service", "killswitch", "use", "profile_add", "profile_rename", "profile_remove", "profile_check", "profile_option", "profile_reveal", "profile_edit", "latency", "sub_add", "sub_refresh", "sub_remove", "engine_install", "engine_remove", "core_install", "setting_set", "logs" ]
   },
   "uci": {
    "unisoc_modem": [ "*" ]
   },
   "cgi-io": [ "upload" ],
   "file": {
    "/tmp/mu300-extra-lang.tar.gz": [ "write" ],
    "/tmp/mu300-vpn-upload": [ "write" ],
    "/tmp/mu300-vpn-extra.tar.gz": [ "write" ]
   }
  }
 },
 "luci-app-mu300-terminal": {
  "description": "Terminal: a root shell on the device in the browser",
  "read": {
   "uci": [ "ttyd" ]
  },
  "write": {
   "ubus": {
    "mu300term": [ "token" ]
   }
  }
 }
}

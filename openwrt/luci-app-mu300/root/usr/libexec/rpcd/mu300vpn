#!/bin/sh
# mu300vpn -- the VPN pages' RPC object of luci-app-mu300 (VPN > Overview, Profiles, Subscriptions, Engines,
# Settings, Logs).
#
# Called by LuCI as:  ubus call mu300vpn <method> '{...}'
#   rpcd runs this script as:  mu300vpn call <method>   with the params JSON on stdin; `mu300vpn list` prints the
#   method declaration blob. The reply is one JSON object on stdout.
#
# The work is mu300-vpn's, the command of the VPN module (github.com/dikeckaan/mu300-linux-vpn), through its
# machine-readable CLI (the module's spec 2026-10-11-engine-extras, section 4: JSON on stdout, messages on stderr,
# exit 0 ok, 1 failed, 2 usage). This object is separate from mu300dash because what passes through it holds secrets
# (share links, configs, subscription URLs, OpenVPN passwords): nothing here is logged (mu300dash keeps every reply
# for its rpcd-crash forensics), and a config may be larger than mu300dash's request limit.
#
# Read methods (the ACL's read grant):
#   status [exit_ip]   mu300-vpn status --json [--exit-ip]; installed 0 (and whether mu300-extra can get it) when the
#                      module is not there, legacy 1 when its mu300-vpn has no --json (module v1)
#   profiles           profile list --json (the CLI masks every secret)
#   engines [check]    engines --json [--check] (check: the release's VERSIONS, a few hundred bytes)
#   subscriptions      subscription list --json (the URL's host only)
#   settings           settings get, as an object of the keys this page shows
#   job                the background task: kind, state, the last lines of its output, a JSON result
# Write methods (the ACL's write grant):
#   service op          on|off|restart
#   killswitch value    on|off
#   use id              the active profile
#   profile_add source data name type   source link|text|file|url; the link, text or URL on stdin of the CLI, the
#                       file the one upload path below; url runs as a task (a download)
#   profile_rename id name, profile_remove id, profile_check id
#   profile_option id key value   an option of the profile's type; OVPN_USER/OVPN_PASS on stdin
#   profile_reveal id   profile show --json --reveal: the raw config (credentials included), for the editor
#   profile_edit id config   profile edit ID - (checked by the CLI before it replaces anything)
#   latency id          one profile inline, all as a task
#   sub_add name url type, sub_refresh id|all (a task), sub_remove id keep
#   engine_install name source (a task), engine_remove name
#   core_install source the vpn extra itself (mu300-extra install vpn, a task)
#   setting_set key value
#   logs engine lines   the service's log (it may name the hosts the device talked to: write, as the AT history)
#
# Long work (downloads, a refresh, a latency round over every profile) runs detached as the one background task,
# bounded in time; the page polls `job`. Only one task at a time.

export PATH="$PATH:/opt/mu300/bin:/opt/mu300/busybox-bin:/usr/sbin:/sbin"

LIB=${0%/*}/../../share/unisoc-modem/lib.sh
[ -f "$LIB" ] || LIB=/usr/share/unisoc-modem/lib.sh
. "$LIB"

VPN=${MU300_VPN_CMD:-/opt/mu300/bin/mu300-vpn}
EXTRA=${MU300_EXTRA_CMD:-/opt/mu300/bin/mu300-extra}
VPN_RUN=${MU300_VPN_RUN:-/run/mu300-vpn}
# The two paths the panel may upload to (the ACL grants exactly these): a profile's config, and an extra's tarball
UPLOAD_CFG=${MU300_VPN_UPLOAD:-/tmp/mu300-vpn-upload}
UPLOAD_PKG=${MU300_VPN_UPLOAD_PKG:-/tmp/mu300-vpn-extra.tar.gz}
DIR=${MU300_DASH_DIR:-$RUN_DIR}
JOB=$DIR/vpn-job
DIR_OK=1
private_dir "$DIR" || DIR_OK=0
[ "$DIR_OK" != 1 ] || private_dir "$JOB" || DIR_OK=0

NL='
'
# A config may be large (a mihomo YAML of a subscription): 128 KiB of request, 64 KiB of config text
INPUT_MAX=131072
TEXT_MAX=65536
# what is read of the CLI's stdout, and of its last message
OUT_MAX=262144
ERR_MAX=300
# an inline call stays under the 30 s rpcd gives it
INLINE_SECS=25
INPUT=

# ------------------------------------------------------------- input, JSON
# As in mu300dash: every parameter is checked against an allow-list before it is used, a refusal answers a fixed
# English error and runs nothing; a value reaches the CLI only as one argument that cannot start with "-" or, when
# it can hold a secret, on its stdin - never in argv, where every local user can read it.
input_too_large() { [ $(($(printf '%s' "$INPUT" | wc -c))) -gt "$INPUT_MAX" ]; }
inp() {
    V=$(printf '%s' "$INPUT" | jsonfilter -e "$1" 2>/dev/null | tr '\000' '\001'; printf x)
    V=${V%x}; V=${V%"$NL"}
    case $V in null) V= ;; esac
}
is_ascii_line() { [ "$(printf '%s' "$1" | LC_ALL=C tr -d ' -~'; echo x)" = x ]; }
allowed() { is_ascii_line "$1" && printf '%s\n' "$1" | LC_ALL=C grep -Eqx -- "$2"; }
# name_ok NAME: a profile or subscription name: 1-64 characters of text (UTF-8 allowed, no control character),
# at most 128 bytes, not starting with "-" or a space, not ending with a space
name_ok() {
    [ -n "$1" ] || return 1
    [ "$(printf '%s' "$1" | LC_ALL=C tr -d '\040-\176\200-\377'; echo x)" = x ] || return 1
    [ "$(printf '%s' "$1" | wc -c)" -le 128 ] || return 1
    [ "$(printf '%s' "$1" | LC_ALL=C tr -d '\200-\277' | wc -c)" -le 64 ] || return 1
    case $1 in -*|' '*|*' ') return 1 ;; esac
}
# text_ok TEXT: a config: no control character but tab, newline and CR, at most TEXT_MAX bytes, not empty
text_ok() {
    [ -n "$1" ] || return 1
    [ "$(printf '%s' "$1" | wc -c)" -le "$TEXT_MAX" ] || return 1
    [ "$(printf '%s' "$1" | LC_ALL=C tr -d '\011\012\015\040-\176\200-\377'; echo x)" = x ]
}
# secret_ok VALUE MAX: one line of printable ASCII or UTF-8 text (an OpenVPN user name or password), at most MAX bytes
secret_ok() {
    [ "$(printf '%s' "$1" | wc -c)" -le "$2" ] || return 1
    [ "$(printf '%s' "$1" | LC_ALL=C tr -d '\040-\176\200-\377'; echo x)" = x ]
}
ID='[a-z0-9][a-z0-9-]{0,31}'
ENGINE='(xray|sing-box|mihomo|dae|wireguard|openvpn)'
# (POSIX regular expressions count to 255 at most: the lengths of a link and a URL are checked by long_ok)
LINK='(vless|vmess|trojan|ss|hysteria2|hy2|tuic|wireguard|wg)://[!-~]+'
URL='https?://[A-Za-z0-9.-]{1,253}(:[0-9]{1,5})?(/[!-~]*)?'
long_ok() { [ ${#1} -le "$2" ]; }
IP4='((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])'
IP6='[0-9A-Fa-f]{0,4}(:[0-9A-Fa-f]{0,4}){2,7}'
CIDR="($IP4/([0-9]|[12][0-9]|3[0-2])|$IP6/([0-9]|[1-9][0-9]|1[01][0-9]|12[0-8]))"
HOSTPORT='([A-Za-z0-9]([A-Za-z0-9.-]{0,252})|\[[0-9A-Fa-f:.]{2,45}\]):[0-9]{1,5}'

json_str_n() { json_str "$(printf '%s' "$1" | head -c "$2")"; }
refuse() {
    if [ -n "${2:-}" ]; then
        printf '{"ok":0,"error":%s,"detail":%s}\n' "$(json_str "$1")" "$(json_str_n "$2" "$ERR_MAX")"
    else
        printf '{"ok":0,"error":%s}\n' "$(json_str "$1")"
    fi
}
# json_val TEXT: TEXT as jsonfilter re-serialises it, if it is one JSON object or array; fails otherwise
json_val() {
    _o=$(printf '%s' "$1" | jsonfilter -e '@' 2>/dev/null) || return 1
    case $_o in '{'*'}'|'['*']') printf '%s\n' "$_o" ;; *) return 1 ;; esac
}

# ------------------------------------------------------------------ the CLI
installed() { [ -x "$VPN" ]; }
# cli ARG...: mu300-vpn with ARGs (stdin: the caller's), bounded in time; OUT its stdout (at most OUT_MAX bytes),
# ERR its last message (the JSON error on stdout, else stderr's last line), RC its status. The two files are in the
# root-only runtime directory and gone before this returns.
cli() {
    _o=$JOB/cli.$$.out; _e=$JOB/cli.$$.err
    if command -v timeout >/dev/null 2>&1; then
        (umask 077; timeout "$INLINE_SECS" "$VPN" "$@" >"$_o" 2>"$_e"); RC=$?
    else
        (umask 077; "$VPN" "$@" >"$_o" 2>"$_e"); RC=$?
    fi
    OUT=$(head -c "$OUT_MAX" "$_o" 2>/dev/null)
    ERR=$(printf '%s' "$OUT" | jsonfilter -e '@.error' 2>/dev/null | head -n 1)
    [ -n "$ERR" ] || ERR=$(tr -d '\r' < "$_e" 2>/dev/null | sed '/^[[:space:]]*$/d' | tail -n 1)
    ERR=$(printf '%s' "$ERR" | LC_ALL=C tr -d '\000-\037\177' | head -c "$ERR_MAX")
    rm -f "$_o" "$_e"
    case $RC in 124|143) ERR='timed out' ;; esac
    return "$RC"
}
# cli_fail MESSAGE: the refusal for a failed cli, the CLI's own message as the detail
cli_fail() {
    if [ "$RC" = 2 ]; then refuse 'The VPN module refused the request' "$ERR"
    else refuse "$1" "$ERR"; fi
}
# reply_list KEY MESSAGE: OUT (a JSON value) as {"ok":1,KEY:OUT}
reply_val() {
    _j=$(json_val "$OUT") || { refuse "$2"; return; }
    printf '{"ok":1,"%s":%s}\n' "$1" "$_j"
}
need_vpn() { installed || { refuse 'The VPN module is not installed'; return 1; }; }
# arg_ok VALUE: never read as an option (a dash first) - every value below is checked by a pattern that already
# ensures it, this is the last line
arg_ok() { case $1 in -*) return 1 ;; esac; }

# ------------------------------------------------------------------- tasks
job_running() { [ -s "$JOB/pid" ] && kill -0 "$(cat "$JOB/pid" 2>/dev/null)" 2>/dev/null; }
# job_start KIND SECS IN JSON CMD ARG...: CMD detached in a new session, the one background task. IN: a file in the
# job directory that becomes CMD's stdin and is removed as soon as it is open (a secret), or empty. JSON=1: CMD's
# stdout is the task's JSON result, its stderr the log; 0: both are the log. At most SECS seconds (timeout, where
# the system has it). Every file of the job directory named upload.* is removed when it ends.
job_start() {
    _kind=$1 _secs=$2 _in=$3 _json=$4; shift 4
    if job_running; then
        [ -z "$_in" ] || rm -f "$_in"
        refuse 'Another VPN task is still running'; return 1
    fi
    rm -f "$JOB/pid" "$JOB/result" "$JOB/out"
    printf '%s\n' "$_kind" > "$JOB/kind"
    echo running > "$JOB/state"
    : > "$JOB/log"
    date +%s > "$JOB/started"
    setsid sh -c '
        echo $$ > "$1/pid"; j=$1; secs=$2; in=$3; json=$4; shift 4
        if [ -n "$in" ]; then exec 3<"$in"; rm -f "$in"; else exec 3</dev/null; fi
        if command -v timeout >/dev/null 2>&1; then set -- timeout "$secs" "$@"; fi
        if [ "$json" = 1 ]; then "$@" <&3 >"$j/out" 2>"$j/log"; else "$@" <&3 >"$j/log" 2>&1; fi
        rc=$?
        exec 3<&-
        if [ "$json" = 1 ]; then head -c 262144 "$j/out" > "$j/result"; fi
        rm -f "$j/out" "$j"/upload.*
        tail -c 16384 "$j/log" > "$j/log.t" && mv "$j/log.t" "$j/log"
        if [ "$rc" = 0 ]; then echo done > "$j/state"; else echo failed > "$j/state"; fi
        rm -f "$j/pid"' mu300vpn-job "$JOB" "$_secs" "$_in" "$_json" "$@" </dev/null >/dev/null 2>&1 &
    printf '{"ok":1,"started":1,"kind":%s}\n' "$(json_str "$_kind")"
}
# take_upload SRC DEST: the file the page uploaded to SRC (/tmp: anyone may write there) renamed into the root-only
# job directory first, and only that copy checked and used - nothing at the /tmp path can be swapped in between
take_upload() {
    rm -f "$2"
    [ -f "$1" ] && [ ! -L "$1" ] || return 1
    mv -f -- "$1" "$2" 2>/dev/null || return 1
    [ -f "$2" ] && [ ! -L "$2" ] && [ -s "$2" ] || { rm -f "$2"; return 1; }
}
# secret_file TEXT: TEXT in a new 0600 file of the job directory (its path in SECRET), for the CLI's stdin: never a
# pipe into cli, which would run it in a subshell (OUT, ERR and RC lost), never an argument
secret_file() {
    SECRET=$JOB/in.$$
    rm -f "$SECRET"
    (umask 077; printf '%s\n' "$1" > "$SECRET")
}

m_job() {
    local kind state started log result
    kind=$(head -c 32 "$JOB/kind" 2>/dev/null | head -n 1)
    state=$(head -c 16 "$JOB/state" 2>/dev/null | head -n 1)
    started=$(head -c 16 "$JOB/started" 2>/dev/null | head -n 1)
    case $started in ''|*[!0-9]*) started= ;; esac
    # running without a live task: it was killed (or the device rebooted) before it could say how it ended - unless
    # it started a moment ago and has not written its pid yet
    if [ "$state" = running ] && ! job_running; then
        if [ -z "$started" ] || [ $(( $(date +%s) - started )) -gt 5 ]; then state=failed; fi
    fi
    case $state in running|done|failed) ;; *) state= ;; esac
    case $kind in core-install|engine-install|sub-add|sub-refresh|latency-all|import-url) ;; *) kind= ;; esac
    log=$(tail -n 30 "$JOB/log" 2>/dev/null | tr -d '\r' | head -c 8192)
    result=$(json_val "$(cat "$JOB/result" 2>/dev/null)") || result=null
    printf '{"ok":1,"job":{"kind":%s,"state":%s,"started":%s,"log":%s,"result":%s}}\n' \
        "$(json_str_or_null "$kind")" "$(json_str_or_null "$state")" "${started:-null}" \
        "$(json_str_or_null "$log")" "$result"
}

# ------------------------------------------------------------------ reads
m_status() {
    local exit_ip st since=null
    inp '@.exit_ip'; exit_ip=$V
    allowed "$exit_ip" '(0|1)?' || { refuse 'The exit_ip parameter must be 0 or 1'; return; }
    if ! installed; then
        printf '{"ok":1,"installed":0,"extra":%d}\n' "$([ -x "$EXTRA" ] && echo 1 || echo 0)"
        return
    fi
    if [ "$exit_ip" = 1 ]; then cli status --json --exit-ip </dev/null; else cli status --json </dev/null; fi
    if ! st=$(json_val "$OUT") || [ "${st#\{}" = "$st" ]; then
        # a module from before the machine-readable CLI (v1: no --json, its status is text): it runs, but this panel
        # cannot read it
        printf '{"ok":1,"installed":1,"legacy":1,"extra":%d}\n' "$([ -x "$EXTRA" ] && echo 1 || echo 0)"
        return
    fi
    # {"error": ...}: the CLI says why it could not
    if [ "$RC" != 0 ] || [ -n "$(printf '%s' "$st" | jsonfilter -e '@.error' 2>/dev/null)" ]; then
        refuse 'The VPN status could not be read' "$ERR"
        return
    fi
    # since: when the tunnel came up (the interface file its last start wrote), for the uptime
    if [ -s "$VPN_RUN/iface" ]; then
        since=$(date -r "$VPN_RUN/iface" +%s 2>/dev/null) || since=
        case $since in ''|*[!0-9]*) since=null ;; esac
    fi
    printf '{"ok":1,"installed":1,"now":%s,"since":%s,"extra":%d,"status":%s}\n' "$(date +%s)" "$since" \
        "$([ -x "$EXTRA" ] && echo 1 || echo 0)" "$st"
}

m_profiles() {
    need_vpn || return
    cli profile list --json </dev/null || { cli_fail 'The profiles could not be read'; return; }
    reply_val profiles 'The profiles could not be read'
}

m_engines() {
    local check
    inp '@.check'; check=$V
    allowed "$check" '(0|1)?' || { refuse 'The check parameter must be 0 or 1'; return; }
    need_vpn || return
    if [ "$check" = 1 ]; then cli engines --json --check </dev/null; else cli engines --json </dev/null; fi ||
        { cli_fail 'The engines could not be read'; return; }
    reply_val engines 'The engines could not be read'
}

m_subscriptions() {
    need_vpn || return
    cli subscription list --json </dev/null || { cli_fail 'The subscriptions could not be read'; return; }
    reply_val subscriptions 'The subscriptions could not be read'
}

# the settings this page shows and sets (the binaries' paths are not the page's: a path root runs)
SETTINGS_SHOWN='KILL_SWITCH TAILSCALE IPV6 REMOTE_DNS BOOTSTRAP_DNS LAN_CIDRS'
m_settings() {
    local k v first=1
    need_vpn || return
    cli settings get </dev/null || { cli_fail 'The VPN settings could not be read'; return; }
    printf '{"ok":1,"settings":{'
    for k in $SETTINGS_SHOWN; do
        v=$(printf '%s\n' "$OUT" | sed -n "s/^$k=//p" | head -n 1)
        [ "$first" = 1 ] || printf ','
        first=0
        printf '"%s":%s' "$k" "$(json_str_n "$v" 512)"
    done
    printf '}}\n'
}

# ------------------------------------------------------------- the service
m_service() {
    local op
    inp '@.op'; op=$V
    allowed "$op" '(on|off|restart)' || { refuse 'Unknown VPN operation'; return; }
    need_vpn || return
    cli "$op" </dev/null || { cli_fail 'The VPN could not be switched'; return; }
    printf '{"ok":1}\n'
}

m_killswitch() {
    local value
    inp '@.value'; value=$V
    allowed "$value" '(on|off)' || { refuse 'The kill switch is on or off'; return; }
    need_vpn || return
    cli killswitch "$value" </dev/null || { cli_fail 'The kill switch could not be changed'; return; }
    printf '{"ok":1}\n'
}

m_use() {
    local id
    inp '@.id'; id=$V
    allowed "$id" "$ID" || { refuse 'Invalid profile id'; return; }
    need_vpn || return
    cli use "$id" </dev/null || { cli_fail 'The profile could not be made the active one'; return; }
    printf '{"ok":1}\n'
}

# ---------------------------------------------------------------- profiles
TYPES='(auto|xray|sing-box|mihomo|wireguard|openvpn|dae)'
# a new profile: a share link, pasted text or the uploaded file, through the CLI's stdin ("-"); a URL is a download
# and runs as a task. type auto: the CLI tells the kind from the source (profile import); another: profile add TYPE.
m_profile_add() {
    local source data name type file
    inp '@.source'; source=$V
    inp '@.data'; data=$V
    inp '@.name'; name=$V
    inp '@.type'; type=$V
    allowed "$source" '(link|text|file|url)' || { refuse 'Unknown profile source'; return; }
    allowed "${type:-auto}" "$TYPES" || { refuse 'Unknown profile type'; return; }
    type=${type:-auto}
    [ -z "$name" ] || name_ok "$name" || { refuse 'Invalid name: 1-64 characters, no control characters'; return; }
    case $source in
        link)
            # without the white space a copy and paste adds
            data=$(printf '%s' "$data" | tr -d '\r' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
            { long_ok "$data" 8000 && allowed "$data" "$LINK"; } || { refuse 'Not a share link this panel takes'; return; } ;;
        text) text_ok "$data" || { refuse 'The config is empty, too large or holds control characters'; return; } ;;
        file) [ -z "$data" ] || { refuse 'Invalid profile request'; return; } ;;
        url)
            { long_ok "$data" 2048 && allowed "$data" "$URL"; } || { refuse 'Not an http or https URL'; return; }
            [ "$type" = auto ] || { refuse 'A config from a URL takes the type it says'; return; } ;;
    esac
    need_vpn || return
    # a type that is not sniffed needs a name (profile add TYPE NAME SRC)
    [ "$type" = auto ] || [ -n "$name" ] || name=$type
    case $source in
        url)
            secret_file "$data" || { refuse 'The runtime directory is not safe; nothing was run'; return; }
            if [ -n "$name" ]; then job_start import-url 120 "$SECRET" 0 "$VPN" profile import --url - "$name"
            else job_start import-url 120 "$SECRET" 0 "$VPN" profile import --url -; fi
            return ;;
        file)
            file=$JOB/upload.profile.$$
            take_upload "$UPLOAD_CFG" "$file" || { refuse 'No uploaded file'; return; }
            [ "$(wc -c < "$file")" -le 1048576 ] || { rm -f "$file"; refuse 'The file is larger than 1 MiB'; return; }
            if [ "$type" = auto ]; then
                if [ -n "$name" ]; then cli profile import - "$name" < "$file"; else cli profile import - < "$file"; fi
            else
                cli profile add "$type" "$name" - < "$file"
            fi
            RC=$?; rm -f "$file" ;;
        *)
            secret_file "$data" || { refuse 'The runtime directory is not safe; nothing was run'; return; }
            if [ "$type" = auto ]; then
                if [ -n "$name" ]; then cli profile import - "$name" < "$SECRET"; else cli profile import - < "$SECRET"; fi
            else
                cli profile add "$type" "$name" - < "$SECRET"
            fi
            RC=$?; rm -f "$SECRET" ;;
    esac
    [ "$RC" = 0 ] || { cli_fail 'The profile could not be added'; return; }
    # the CLI prints the new profile's id
    id=$(printf '%s\n' "$OUT" | tail -n 1)
    allowed "$id" "$ID" || id=
    printf '{"ok":1,"id":%s}\n' "$(json_str_or_null "$id")"
}

m_profile_rename() {
    local id name
    inp '@.id'; id=$V
    inp '@.name'; name=$V
    allowed "$id" "$ID" || { refuse 'Invalid profile id'; return; }
    name_ok "$name" && arg_ok "$name" || { refuse 'Invalid name: 1-64 characters, no control characters'; return; }
    need_vpn || return
    cli profile set "$id" NAME "$name" </dev/null || { cli_fail 'The profile could not be renamed'; return; }
    printf '{"ok":1}\n'
}

m_profile_remove() {
    local id
    inp '@.id'; id=$V
    allowed "$id" "$ID" || { refuse 'Invalid profile id'; return; }
    need_vpn || return
    cli profile remove "$id" </dev/null || { cli_fail 'The profile could not be removed'; return; }
    printf '{"ok":1}\n'
}

m_profile_check() {
    local id
    inp '@.id'; id=$V
    allowed "$id" "$ID" || { refuse 'Invalid profile id'; return; }
    need_vpn || return
    cli profile check "$id" </dev/null || { cli_fail 'The profile does not pass the check'; return; }
    printf '{"ok":1}\n'
}

# the options of the profile types (the drivers' DRV_KEYS): OVPN_USER and OVPN_PASS travel on stdin ("-")
m_profile_option() {
    local id key value
    inp '@.id'; id=$V
    inp '@.key'; key=$V
    inp '@.value'; value=$V
    allowed "$id" "$ID" || { refuse 'Invalid profile id'; return; }
    case $key in
        MIHOMO_STACK)        allowed "$value" '(gvisor|system|mixed)?' ;;
        TLS_PIN_SHA256)      long_ok "$value" 512 && allowed "$value" '[0-9A-Fa-f:,]*' ;;
        UPSTREAM_HTTP_PROXY) [ -z "$value" ] || allowed "$value" "$HOSTPORT" ;;
        OVPN_USER)           secret_ok "$value" 128 ;;
        OVPN_PASS)           secret_ok "$value" 256 ;;
        *) refuse 'Unknown profile option'; return ;;
    esac || { refuse 'Invalid value for this option'; return; }
    need_vpn || return
    case $key in
        OVPN_*)
            secret_file "$value" || { refuse 'The runtime directory is not safe; nothing was run'; return; }
            cli profile set "$id" "$key" - < "$SECRET"; RC=$?; rm -f "$SECRET" ;;
        *) cli profile set "$id" "$key" "$value" </dev/null ;;
    esac
    [ "$RC" = 0 ] || { cli_fail 'The option could not be set'; return; }
    printf '{"ok":1}\n'
}

# the raw config, credentials included: asked for by the page's reveal step, never logged, never in a read grant
m_profile_reveal() {
    local id cfg
    inp '@.id'; id=$V
    allowed "$id" "$ID" || { refuse 'Invalid profile id'; return; }
    need_vpn || return
    cli profile show "$id" --json --reveal </dev/null || { cli_fail 'The config could not be read'; return; }
    cfg=$(printf '%s' "$OUT" | jsonfilter -e '@.config' 2>/dev/null; printf x)
    cfg=${cfg%x}; cfg=${cfg%"$NL"}
    [ -n "$cfg" ] || { refuse 'The config could not be read'; return; }
    printf '{"ok":1,"config":%s}\n' "$(json_str "$cfg")"
}

m_profile_edit() {
    local id config
    inp '@.id'; id=$V
    inp '@.config'; config=$V
    allowed "$id" "$ID" || { refuse 'Invalid profile id'; return; }
    text_ok "$config" || { refuse 'The config is empty, too large or holds control characters'; return; }
    need_vpn || return
    secret_file "$config" || { refuse 'The runtime directory is not safe; nothing was run'; return; }
    cli profile edit "$id" - < "$SECRET"; RC=$?; rm -f "$SECRET"
    [ "$RC" = 0 ] || { cli_fail 'The config was not saved'; return; }
    printf '{"ok":1}\n'
}

m_latency() {
    local id
    inp '@.id'; id=$V
    allowed "$id" "(all|$ID)" || { refuse 'Invalid profile id'; return; }
    need_vpn || return
    if [ "$id" = all ]; then
        job_start latency-all 300 '' 1 "$VPN" latency --all --json
        return
    fi
    cli latency "$id" --json </dev/null
    # a failed test is a result too ({"ms": null, "error": ...}, exit 1)
    _j=$(json_val "$OUT") || { cli_fail 'The latency test failed'; return; }
    printf '{"ok":1,"result":%s}\n' "$_j"
}

# ----------------------------------------------------------- subscriptions
m_sub_add() {
    local name url type
    inp '@.name'; name=$V
    inp '@.url'; url=$V
    inp '@.type'; type=$V
    name_ok "$name" || { refuse 'Invalid name: 1-64 characters, no control characters'; return; }
    url=$(printf '%s' "$url" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
    { long_ok "$url" 2048 && allowed "$url" "$URL"; } || { refuse 'Not an http or https URL'; return; }
    allowed "${type:-auto}" '(auto|links|mihomo|dae)' || { refuse 'Unknown subscription type'; return; }
    need_vpn || return
    # the URL holds the subscription's token: on stdin, from a 0600 file the task removes once it is open
    secret_file "$url" || { refuse 'The runtime directory is not safe; nothing was run'; return; }
    job_start sub-add 180 "$SECRET" 0 "$VPN" subscription add "$name" - --type "${type:-auto}"
}

m_sub_refresh() {
    local id
    inp '@.id'; id=$V
    allowed "$id" "(all|$ID)" || { refuse 'Invalid subscription id'; return; }
    need_vpn || return
    if [ "$id" = all ]; then job_start sub-refresh 300 '' 0 "$VPN" subscription refresh --all
    else job_start sub-refresh 180 '' 0 "$VPN" subscription refresh "$id"; fi
}

m_sub_remove() {
    local id keep
    inp '@.id'; id=$V
    inp '@.keep'; keep=$V
    allowed "$id" "$ID" || { refuse 'Invalid subscription id'; return; }
    allowed "$keep" '(0|1)?' || { refuse 'The keep parameter must be 0 or 1'; return; }
    need_vpn || return
    if [ "$keep" = 1 ]; then cli subscription remove "$id" --keep-profiles </dev/null
    else cli subscription remove "$id" </dev/null; fi || { cli_fail 'The subscription could not be removed'; return; }
    printf '{"ok":1}\n'
}

# ----------------------------------------------------------------- engines
# the release file of an engine's extra, which an offline install names
engine_asset() {
    case $1 in xray) echo mu300-linux-vpn-xray.tar.gz ;; sing-box) echo mu300-linux-vpn-singbox.tar.gz ;;
        mihomo) echo mu300-linux-vpn-mihomo.tar.gz ;; dae) echo mu300-linux-vpn-dae.tar.gz ;; esac
}
m_engine_install() {
    local name source file
    inp '@.name'; name=$V
    inp '@.source'; source=$V
    allowed "$name" "$ENGINE" || { refuse 'Unknown engine'; return; }
    allowed "${source:-release}" '(release|file)' || { refuse 'Unknown source'; return; }
    need_vpn || return
    if [ "$source" = file ]; then
        case $name in wireguard|openvpn) refuse 'This engine is a system package: it has no file to upload'; return ;; esac
        file=$JOB/upload.$(engine_asset "$name")
        take_upload "$UPLOAD_PKG" "$file" || { refuse 'No uploaded file'; return; }
        job_start engine-install 1200 '' 0 "$VPN" engine install "$name" --from "$file"
    else
        job_start engine-install 1200 '' 0 "$VPN" engine install "$name"
    fi
}

m_engine_remove() {
    local name
    inp '@.name'; name=$V
    allowed "$name" "$ENGINE" || { refuse 'Unknown engine'; return; }
    need_vpn || return
    job_running && { refuse 'Another VPN task is still running'; return; }
    cli engine remove "$name" </dev/null || { cli_fail 'The engine could not be removed'; return; }
    printf '{"ok":1}\n'
}

# the module itself, when it is not there (or too old for this panel): mu300-extra install vpn
m_core_install() {
    local source file
    inp '@.source'; source=$V
    allowed "${source:-release}" '(release|file)' || { refuse 'Unknown source'; return; }
    [ -x "$EXTRA" ] || { refuse 'mu300-extra is not on this system'; return; }
    if [ "$source" = file ]; then
        file=$JOB/upload.mu300-linux-vpn-core.tar.gz
        take_upload "$UPLOAD_PKG" "$file" || { refuse 'No uploaded file'; return; }
        job_start core-install 1200 '' 0 "$EXTRA" install vpn --from "$file"
    else
        job_start core-install 1200 '' 0 "$EXTRA" install vpn
    fi
}

# ---------------------------------------------------------------- settings
m_setting_set() {
    local key value
    inp '@.key'; key=$V
    inp '@.value'; value=$V
    # an empty value puts the setting back to its default
    case $key in
        TAILSCALE)                 allowed "$value" '(0|1)?' ;;
        IPV6)                      allowed "$value" '(0|1|auto)?' ;;
        REMOTE_DNS|BOOTSTRAP_DNS)  [ -z "$value" ] || allowed "$value" "($IP4|$IP6)" ;;
        LAN_CIDRS)                 [ -z "$value" ] || allowed "$value" "$CIDR(,$CIDR){0,31}" ;;
        *) refuse 'Unknown VPN setting'; return ;;
    esac || { refuse 'Invalid value for this setting'; return; }
    need_vpn || return
    cli settings set "$key" "$value" </dev/null || { cli_fail 'The setting could not be saved'; return; }
    printf '{"ok":1}\n'
}

m_logs() {
    local engine lines
    inp '@.engine'; engine=$V
    inp '@.lines'; lines=$V
    allowed "${engine:-all}" "(all|$ENGINE)" || { refuse 'Unknown engine'; return; }
    allowed "${lines:-100}" '[1-9][0-9]{0,3}' && [ "${lines:-100}" -le 1000 ] ||
        { refuse 'The number of lines is 1 to 1000'; return; }
    need_vpn || return
    if [ -z "$engine" ] || [ "$engine" = all ]; then cli logs -n "${lines:-100}" </dev/null
    else cli logs "$engine" -n "${lines:-100}" </dev/null; fi || { cli_fail 'The log could not be read'; return; }
    # the last 64 KiB of it, whole lines
    printf '{"ok":1,"log":%s}\n' "$(json_str "$(printf '%s\n' "$OUT" | tail -c 65536 | tr -d '\r')")"
}

do_list() {
    cat <<EOF
{
	"status": { "exit_ip": "String" },
	"profiles": { },
	"engines": { "check": "String" },
	"subscriptions": { },
	"settings": { },
	"job": { },
	"service": { "op": "String" },
	"killswitch": { "value": "String" },
	"use": { "id": "String" },
	"profile_add": { "source": "String", "data": "String", "name": "String", "type": "String" },
	"profile_rename": { "id": "String", "name": "String" },
	"profile_remove": { "id": "String" },
	"profile_check": { "id": "String" },
	"profile_option": { "id": "String", "key": "String", "value": "String" },
	"profile_reveal": { "id": "String" },
	"profile_edit": { "id": "String", "config": "String" },
	"latency": { "id": "String" },
	"sub_add": { "name": "String", "url": "String", "type": "String" },
	"sub_refresh": { "id": "String" },
	"sub_remove": { "id": "String", "keep": "String" },
	"engine_install": { "name": "String", "source": "String" },
	"engine_remove": { "name": "String" },
	"core_install": { "source": "String" },
	"setting_set": { "key": "String", "value": "String" },
	"logs": { "engine": "String", "lines": "String" }
}
EOF
}

case "${1:-}" in
list)
    do_list
    ;;
call)
    INPUT=$(cat 2>/dev/null)
    if input_too_large; then
        refuse 'Request too large'
        exit 0
    fi
    if [ "$DIR_OK" != 1 ]; then
        refuse 'The runtime directory is not safe; nothing was run'
        exit 0
    fi
    # nothing of a reply is logged: replies can hold a config (profile_reveal)
    case ${2:-} in
        status)         m_status ;;
        profiles)       m_profiles ;;
        engines)        m_engines ;;
        subscriptions)  m_subscriptions ;;
        settings)       m_settings ;;
        job)            m_job ;;
        service)        m_service ;;
        killswitch)     m_killswitch ;;
        use)            m_use ;;
        profile_add)    m_profile_add ;;
        profile_rename) m_profile_rename ;;
        profile_remove) m_profile_remove ;;
        profile_check)  m_profile_check ;;
        profile_option) m_profile_option ;;
        profile_reveal) m_profile_reveal ;;
        profile_edit)   m_profile_edit ;;
        latency)        m_latency ;;
        sub_add)        m_sub_add ;;
        sub_refresh)    m_sub_refresh ;;
        sub_remove)     m_sub_remove ;;
        engine_install) m_engine_install ;;
        engine_remove)  m_engine_remove ;;
        core_install)   m_core_install ;;
        setting_set)    m_setting_set ;;
        logs)           m_logs ;;
        *)              refuse 'No such method' ;;
    esac
    ;;
*)
    echo "usage: $0 {list|call <method>}" >&2
    exit 2
    ;;
esac

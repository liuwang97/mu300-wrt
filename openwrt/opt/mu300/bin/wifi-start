#!/bin/sh
# Bring up the SC2355 (Marlin3) Wi-Fi: PCIe host, WCN platform driver, then the WLAN driver.
# Firmware (wcnmodem.bin, wifi_board_config*.ini) comes from Android's /odm/firmware -> /usr/lib/firmware.
# 5.4 vendor kernel: all four are modules. Mainline: the PCIe host is built in, wcn_bsp/sprd_wlan_combo are
# out-of-tree modules in /lib/modules/<release>.
set -e
command -v depmod >/dev/null && depmod -a
[ -e /sys/class/net/wlan0 ] && exit 0   # the WCN drivers cannot be reloaded; never load them twice
for m in pcie-sprd-misc pcie-sprd; do
    modprobe "$m" 2>/dev/null || [ -d /sys/bus/platform/drivers/sprd-pcie ]
done
for m in wcn_bsp sprd_wlan_combo; do
    grep -q "^$m " /proc/modules || modprobe "$m"
done
for n in $(seq 1 30); do [ -e /sys/class/net/wlan0 ] && break; sleep 1; done
ls /sys/class/net

#!/bin/sh
# Keep the modem's AT channel open and hand it out one command at a time.
#
# /dev/stty_nr* are SIPC channels, not real serial ports, and only one reader gets the data: while this daemon
# holds the channel, a second process that opens the device reads nothing. Android's RIL keeps its port open for
# the lifetime of the system, and so does this daemon, so that AT commands cost one open instead of one per call.
#
# The one case where the descriptor has to be replaced is a modem restart (AT+SFUN=4, or a CP crash): the old
# descriptor then refers to a channel that no longer exists and stays silent for ever, while still occupying the
# device. The loop below notices that and reopens - see the comment there.
#
#   mu300-atd            run in the foreground (used by the service)
#   mu300-at "AT+CSQ"    ask the daemon (see mu300-at)
#
# Reading this tty needs a shell with "read -t":
#   * dash (which is /bin/sh on Ubuntu and Debian) has no -t at all. Every read fails instantly with "Illegal
#     option", the reply loop spins through its timeout and the command comes back empty.
#   * The tty's own timer cannot replace it: "stty min 0 time 5" is ignored by this driver, which blocks in
#     sbuf_read until the modem says something - possibly for ever.
# bash and busybox ash both implement -t with poll(), which this driver does support, so run under one of them.
set -u
# OpenWrt keeps the applets this needs (timeout, dd) in the static busybox next to us
export PATH="$PATH:/opt/mu300/bin:/opt/mu300/busybox-bin:/usr/sbin:/sbin"
if [ -n "$(read -t 1 _probe </dev/null 2>&1)" ]; then
    for sh in /bin/bash /usr/bin/bash /bin/busybox; do
        [ -x "$sh" ] || continue
        case $sh in */busybox) exec "$sh" ash "$0" "$@" ;; *) exec "$sh" "$0" "$@" ;; esac
    done
    echo "mu300-atd: need bash or busybox ash (this shell has no 'read -t')" >&2; exit 1
fi
DEV=${MU300_AT_DEV:-/dev/stty_nr1}
DIR=${MU300_AT_DIR:-/run/mu300-at}
CMD=$DIR/cmd
CR=$(printf '\r')

[ -c "$DEV" ] || { echo "mu300-atd: $DEV is not a character device" >&2; exit 1; }
mkdir -p "$DIR"

# Exactly one daemon, or the modem looks dead to the whole device. Two of them read the same SIPC channel and
# each gets a random half of every reply, and the newcomer replaces the command fifo under the one already
# running - which is how "the modem stopped answering after a few minutes" kept happening. A second instance
# (procd respawning, a service started twice) waits here instead of exiting, so that whoever holds the channel
# keeps it and the spare takes over the moment that process is gone.
LOCK=$DIR/lock
alive() {  # alive PID -> is that pid still a running mu300-atd?
    [ -n "$1" ] && [ -d "/proc/$1" ] && tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null | grep -q mu300-atd
}
while :; do
    if mkdir "$LOCK" 2>/dev/null; then break; fi
    owner=$(cat "$LOCK/pid" 2>/dev/null || true)
    if alive "$owner"; then
        [ "${waited:-0}" = 0 ] && echo "mu300-atd: pid $owner already owns $DEV, waiting" >&2
        waited=1
        sleep 10
        continue
    fi
    rm -rf "$LOCK"   # the owner is gone (killed, or the device rebooted with /run on disk)
done
echo $$ > "$LOCK/pid"
# Only on a signal, never on EXIT: ash and dash run an EXIT trap when a *subshell* exits too, and this script
# runs one per command (reply=$(collect ...)), so an EXIT trap here deletes the lock a second after taking it -
# which is how the second daemon got in in the first place. A daemon that dies without being signalled leaves
# the directory behind; the next one sees the owner is gone and takes over.
trap 'rm -f "$CMD"; [ "$(cat "$LOCK/pid" 2>/dev/null)" = $$ ] && rm -rf "$LOCK"; exit 0' INT TERM

rm -f "$CMD"
mkfifo -m 600 "$CMD"

# the one open that everything else borrows
open_tty() {
    exec 3<&- 2>/dev/null || true
    exec 3<>"$DEV" || return 1
    # on fd 3, not "stty -F $DEV": the -F form opens and closes the tty a second time
    stty raw -echo <&3 2>/dev/null || true
}
open_tty || { echo "mu300-atd: cannot open $DEV" >&2; exit 1; }

trap "" PIPE   # a client that gave up waiting must not kill the daemon
silent=0       # consecutive commands the modem did not answer
last_reopen=0  # when the device was last reopened (see the reopen rule in the loop)

now() { date +%s; }

drain() {  # throw away whatever the modem sent while nobody was asking (URCs), so replies are not mixed up
    end=$(( $(now) + 3 ))
    while [ "$(now)" -lt "$end" ]; do
        junk=
        IFS= read -r -t 1 junk <&3 || break   # nothing for a second: the channel is quiet again
    done
}

collect() {  # collect TIMEOUT -> the reply lines, up to the final result code
    end=$(( $(now) + $1 ))
    while [ "$(now)" -lt "$end" ]; do
        l=
        IFS= read -r -t 2 l <&3 || continue
        l=${l%"$CR"}
        [ -n "$l" ] || continue
        echo "$l"
        case $l in
            OK|ERROR|+CME\ ERROR*|+CMS\ ERROR*|CONNECT*|NO\ CARRIER) return 0 ;;
        esac
    done
}

while :; do
    line=
    # blocks until a client sends something
    read -r line < "$CMD" || continue
    [ -n "$line" ] || continue
    # "SECONDS /path/to/answer AT+COMMAND": the answer goes into a file of the client's choosing. A fifo needs
    # both ends at once, and a client that gave up (or was killed) left the daemon or a leftover writer blocked
    # on it for ever, which wedged every later command.
    t=${line%% *}
    case $t in
        [0-9]|[0-9][0-9]) rest=${line#* } ;;
        *) t=6; rest=$line ;;
    esac
    answer=
    case $rest in
        /*) answer=${rest%% *}; cmd=${rest#* } ;;
        *) cmd=$rest ;;
    esac
    drain
    printf '%s\r' "$cmd" >&3
    reply=$(collect "$t")
    # When the modem restarts (AT+SFUN=4 during a bring-up, or a CP crash) this descriptor is left attached to a
    # channel that no longer exists: it reads nothing for ever, and because it still holds the channel, nobody
    # else can talk to the modem either - which is what used to look like "the tty is wedged until the modem is
    # restarted". Reopening it is the cure, but it is not free: closing and opening the SIPC channel is the one
    # operation that can lose it (13b), so only do it when the silence really looks like a restarted modem -
    # three unanswered commands in a row, and not more than once a minute. A busy device that makes this shell
    # miss a reply now and then must not cost us the channel.
    if [ -z "$reply" ]; then
        silent=$((silent + 1))
        if [ "$silent" -ge 3 ] && [ $(( $(now) - last_reopen )) -ge 60 ]; then
            echo "mu300-atd: three unanswered commands, reopening $DEV" >&2
            last_reopen=$(now)
            if open_tty; then
                silent=0
                drain
                printf '%s\r' "$cmd" >&3
                reply=$(collect "$t")
            fi
        fi
    else
        silent=0
    fi
    if [ -n "$answer" ]; then
        # write it complete, then move it into place, so the client never reads half an answer
        printf '%s\n' "$reply" > "$answer.part" 2>/dev/null && mv "$answer.part" "$answer" 2>/dev/null
    fi
done

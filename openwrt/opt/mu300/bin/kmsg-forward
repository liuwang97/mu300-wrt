#!/bin/sh
# Forward kernel warnings and errors into the journal, minus the vendor chatter that repeats forever on this
# hardware. Patterns (extended regular expressions, one per line) come from /etc/mu300/kmsg-ignore; comment a line
# out to see those messages again. Everything still lands in `dmesg`, this only decides what is written to disk.
IGNORE=${MU300_KMSG_IGNORE:-/etc/mu300/kmsg-ignore}
if [ -s "$IGNORE" ] && grep -qv '^[[:space:]]*\(#.*\)\?$' "$IGNORE"; then
    pat=$(grep -v '^[[:space:]]*\(#.*\)\?$' "$IGNORE" | tr '\n' '|' | sed 's/|$//')
    exec dmesg --follow-new --level=emerg,alert,crit,err,warn --notime \
        | grep --line-buffered -Ev "$pat" | systemd-cat -t kernel -p warning
fi
exec dmesg --follow-new --level=emerg,alert,crit,err,warn --notime | systemd-cat -t kernel -p warning

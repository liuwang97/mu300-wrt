#!/bin/sh
# The initramfs already bound the ECM gadget (usb0). Give it an address and serve DHCP to the host.
for n in $(seq 1 30); do ip link show usb0 >/dev/null 2>&1 && break; sleep 1; done
ip addr replace 192.168.77.1/24 dev usb0
ip link set usb0 up
exec dnsmasq --keep-in-foreground --conf-file=/dev/null --interface=usb0 --bind-interfaces \
    --dhcp-range=192.168.77.2,192.168.77.9,255.255.255.0,12h --dhcp-leasefile=/run/mu300-usb0.leases

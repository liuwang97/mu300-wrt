#!/bin/sh
# adb over USB to Linux: adbd (/opt/mu300/bin/adbd, tools/adbd) as a function of the USB gadget, next to the network
# and the serial console. Run by the mu300-adbd service when "mu300-usb adb on" (/etc/mu300/adb) says so; by hand:
#   mu300-adbd run       keep adbd running in the gadget (the service): exits at once when adb is off
#   mu300-adbd stop      take it out of the gadget again (after the service: its ExecStopPost; turn adb off with
#                        mu300-usb adb off, or the service puts it back)
#   mu300-adbd status    what is set up
# The gadget (boot/init) is made and bound before any system runs; adbd joins it later, so this rebinds it once, which
# looks like a replug to the computer (the network and the console drop for a moment). FunctionFS wants its
# descriptors before the bind: the function goes into the configuration once adbd has written them (ep1 exists).
# FunctionFS also unbinds the whole gadget whenever adbd closes its control endpoint, and adbd does that at the end of
# every adb connection (a computer that unplugs, sleeps or resets its USB): Android's init then binds the gadget again
# (sys.usb.ffs.ready), here the loop of "run" does it, with adb when adbd is ready and without it otherwise, so the
# network and the console never stay away. Not in the U30 Air's host role (mu300-usb host): the gadget is left alone.
# Interfaces: the network function, the console, then adb (ff/42/01, "ADB Interface"): adding adb changes no number.
# bcdDevice 0x0303 (0x0304 with RNDIS) while adb is in the gadget: Windows caches the MS OS descriptors per
# VID/PID/bcdDevice, and adbd's ask for WinUSB for its interface, as Android's do. The MS OS descriptors are on in the
# NCM/ECM configuration too while adb is there (boot/init has them for RNDIS only).
# Authentication: adbd takes only keys listed in /etc/mu300/adb_keys or /root/.android/adb_keys (mu300-usb adb key).
# Anyone whose key is listed there gets a root shell.
export PATH="$PATH:/opt/mu300/bin:/opt/mu300/busybox-bin:/usr/sbin:/sbin"
G=${MU300_GADGET:-/sys/kernel/config/usb_gadget/linux}
ROLE=${MU300_USB_ROLE:-/sys/class/usb_role/25100000.dwc3-role-switch/role}
FFS=${MU300_FFS:-/dev/usb-ffs/adb}
ADBD=${MU300_ADBD_BIN:-/opt/mu300/bin/adbd}
CONF=${MU300_ADB_CONF:-/etc/mu300/adb}
FILESYSTEMS=${MU300_PROC_FILESYSTEMS:-/proc/filesystems}
MOUNTS=${MU300_PROC_MOUNTS:-/proc/mounts}
BUILTIN=${MU300_MODULES_BUILTIN:-/lib/modules/$(uname -r)/modules.builtin}
UDC_CLASS=${MU300_UDC_CLASS:-/sys/class/udc}
HOOK=${MU300_USB_HOOK:-/etc/hotplug.d/iface/10-mu300-usb}
TICK=${MU300_ADBD_TICK:-1}     # seconds between two looks at the gadget
GRACE=${MU300_ADBD_GRACE:-5}   # looks at an unbound gadget before it is bound again
F=$G/functions/ffs.adb
L=$G/configs/c.1/f3

log() { echo "mu300-adbd: $*" >&2; }   # the service keeps it (journal, logread)
nap() { sleep "$1" 2>/dev/null || sleep 1; }
adb_on() { [ "$(cat "$CONF" 2>/dev/null)" = on ]; }
host_role() { [ "$(cat "$ROLE" 2>/dev/null)" = host ]; }
ffs_ready() { [ -e "$FFS/ep1" ]; }
linked() { [ -e "$L" ] || [ -L "$L" ]; }
rndis() { case $(readlink "$G/configs/c.1/f1" 2>/dev/null) in *rndis*) return 0 ;; esac; return 1; }
udc_name() {  # the controller: the one bound now, or the first there is
    u=$(cat "$G/UDC" 2>/dev/null)
    [ -n "$u" ] || u=$(ls "$UDC_CLASS" 2>/dev/null | head -n1)
    echo "$u"
}
unbind() { [ -z "$(cat "$G/UDC" 2>/dev/null)" ] || echo "" > "$G/UDC" 2>/dev/null; }

# the configuration with or without adb (unbound only: configfs refuses links and descriptors of a bound gadget)
with_adb() {
    linked || ln -s "$F" "$L" || return 1
    if rndis; then echo 0x0304 > "$G/bcdDevice"; else
        echo 0x0303 > "$G/bcdDevice"
        echo 0xcd > "$G/os_desc/b_vendor_code" 2>/dev/null
        echo MSFT100 > "$G/os_desc/qw_sign" 2>/dev/null
        echo 1 > "$G/os_desc/use" 2>/dev/null
        [ -e "$G/os_desc/c.1" ] || [ -L "$G/os_desc/c.1" ] || ln -s "$G/configs/c.1" "$G/os_desc/c.1" 2>/dev/null
    fi
    return 0
}
without_adb() {
    rm -f "$L"
    if rndis; then echo 0x0302 > "$G/bcdDevice"; else
        echo 0x0301 > "$G/bcdDevice"
        rm -f "$G/os_desc/c.1"
        [ -e "$G/os_desc/use" ] && echo 0 > "$G/os_desc/use"
    fi
    return 0
}

# bind UDC; up to N tries 0.2 s apart (adbd rewrites its descriptors when no bind came within a second, and a bind
# in that gap fails)
bind() {
    n=0
    while [ "$n" -lt "${2:-10}" ]; do
        echo "$1" > "$G/UDC" 2>/dev/null && [ "$(cat "$G/UDC" 2>/dev/null)" = "$1" ] && return 0
        n=$((n + 1)); nap 0.2
    done
    return 1
}
# the gadget netdevs back into the LAN after a rebind (as mu300-usb-reset): they should survive it, this is a guard
lan_back() {
    for nic in usb0 rndis0; do
        [ -e "/sys/class/net/$nic" ] || continue
        ip link set "$nic" master br-lan 2>/dev/null || true
        ip link set "$nic" up 2>/dev/null || true
    done
    [ -x "$HOOK" ] && ACTION=ifup INTERFACE=lan "$HOOK" >/dev/null 2>&1
    return 0
}

# rebind WANT: unbind, put adb in (WANT=adb, when adbd is ready) or take it out, bind again. A gadget that will not
# bind with adb is bound without it: the network and the console come first. Status 2: bound, but without the adb
# that was wanted; 1: not bound at all.
rebind() {
    u=$(udc_name)
    [ -n "$u" ] || { log "no USB device controller"; return 1; }
    unbind
    if [ "$1" = adb ] && ffs_ready && with_adb && bind "$u"; then
        lan_back; log "gadget bound on $u with adb"; return 0
    fi
    without_adb
    bind "$u" 30 || { log "could not bind the gadget on $u"; return 1; }
    lan_back
    [ "$1" = adb ] || return 0
    log "gadget bound on $u without adb (adbd is not ready)"
    return 2
}

prepare() {
    if [ ! -d "$G" ]; then   # init unmounts configfs before switch_root
        mkdir -p /sys/kernel/config 2>/dev/null
        mount -t configfs configfs /sys/kernel/config 2>/dev/null
    fi
    [ -d "$G" ] || { log "no USB gadget at $G"; return 1; }
    [ -d "$F" ] || mkdir "$F" 2>/dev/null || { log "cannot make the FunctionFS function (kernel without USB_CONFIGFS_F_FS?)"; return 1; }
    mkdir -p "$FFS"
    grep -q " $FFS functionfs " "$MOUNTS" 2>/dev/null || mount -t functionfs adb "$FFS" ||
        { log "cannot mount FunctionFS at $FFS"; return 1; }
}
# out of the gadget: unbound, unlinked, bound again; then the function and its mount go
teardown() {
    if linked; then
        rebind none
    elif [ -z "$(cat "$G/UDC" 2>/dev/null)" ] && ! host_role; then
        u=$(udc_name); [ -n "$u" ] && bind "$u" 30 && lan_back
    fi
    grep -q " $FFS functionfs " "$MOUNTS" 2>/dev/null && umount "$FFS" 2>/dev/null
    [ -d "$F" ] && ! linked && rmdir "$F" 2>/dev/null
    return 0
}

usable() {  # why adb cannot run here, if it cannot
    [ -x "$ADBD" ] || { echo "no adbd in this system ($ADBD): mu300-update apply brings an image with it"; return 1; }
    # FunctionFS registers its filesystem only with its first function: before that, the kernel's list of built-in
    # modules tells, or making the function
    grep -qw functionfs "$FILESYSTEMS" 2>/dev/null || grep -qs '/usb_f_fs\.ko$' "$BUILTIN" || [ -d "$F" ] ||
        { mkdir "$F" 2>/dev/null && rmdir "$F"; } ||
        { echo "this kernel has no FunctionFS (CONFIG_USB_CONFIGFS_F_FS): 5.4 has it, a mainline kernel from a release with adb (mu300-update kernel)"; return 1; }
}

run() {
    adb_on || { echo "adb is off (mu300-usb adb on)"; exit 0; }
    why=$(usable) || { log "$why"; exit 0; }
    prepare || exit 1
    stopping= pid= exits= t0= idle=0 cool=0
    trap 'stopping=1' TERM INT HUP
    while [ -z "$stopping" ]; do
        if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
            if [ -n "$pid" ]; then
                wait "$pid" 2>/dev/null; log "adbd exited ($?), restarting it"
                now=$(cut -d. -f1 /proc/uptime 2>/dev/null || echo 0)
                [ -n "$t0" ] && [ $((now - t0)) -lt 60 ] || { t0=$now; exits=0; }
                exits=$((exits + 1))
                [ "$exits" -lt 5 ] || { log "adbd keeps exiting: adb is left out of the gadget"; teardown; exit 1; }
                cool=0
            fi
            "$ADBD" </dev/null &
            pid=$!
            # its first descriptors: up to 5 s
            n=0; while [ "$n" -lt 25 ] && ! ffs_ready && kill -0 "$pid" 2>/dev/null; do nap 0.2; n=$((n + 1)); done
        fi
        if host_role; then idle=0
        elif [ -z "$(cat "$G/UDC" 2>/dev/null)" ]; then
            # FunctionFS took the gadget off the controller (an adb connection ended). Not at once: mu300-usb-reset
            # and the OpenWrt LAN hook unbind it on purpose for a few seconds, and bind it again themselves.
            idle=$((idle + 1))
            if [ "$idle" -ge "$GRACE" ]; then
                n=0; while [ "$n" -lt 25 ] && ! ffs_ready; do nap 0.2; n=$((n + 1)); done
                rebind adb || cool=30
                idle=0
            fi
        elif [ "$cool" -gt 0 ]; then
            # adb would not bind a moment ago: the gadget is bound without it, and is not unbound every second
            idle=0; cool=$((cool - 1))
        else
            idle=0
            linked || ! ffs_ready || rebind adb || cool=30   # adbd has just started: into the gadget
        fi
        nap "$TICK"
    done
    [ -n "$pid" ] && kill "$pid" 2>/dev/null && wait "$pid" 2>/dev/null
    teardown
    exit 0
}

case ${1:-status} in
    run) run ;;
    usable) usable ;;
    stop)
        [ "$(id -u)" = 0 ] || { echo "run as root" >&2; exit 1; }
        [ -d "$G" ] || exit 0
        pkill -x adbd 2>/dev/null || killall adbd 2>/dev/null
        teardown ;;
    status)
        echo "adb: $(cat "$CONF" 2>/dev/null || echo off)"
        why=$(usable) && echo "adbd: $ADBD" || echo "adbd: cannot run: $why"
        if linked; then echo "gadget: adb is in it ($(cat "$G/UDC" 2>/dev/null || echo unbound))"; else echo "gadget: without adb"; fi
        k=0
        for f in /etc/mu300/adb_keys /root/.android/adb_keys; do
            c=$(grep -c '^QAAAA' "$f" 2>/dev/null); k=$((k + ${c:-0}))
        done
        [ "$(id -u)" = 0 ] && echo "authorised keys: $k" ;;
    *) sed -n '2,7s/^# \{0,1\}//p' "$0" >&2; exit 2 ;;
esac

#!/bin/sh
# Which device this is: f50 or u30air. boot/init writes it to /run/mu300/device; a boot image from before that
# (an older release's kernel, or a mainline one) does not, so then the device tree tells, the way init decides:
# only the U30 Air's has the charger policy service.
if [ -s /run/mu300/device ]; then
    cat /run/mu300/device
elif [ -d /proc/device-tree/charger_policy_service ]; then
    echo u30air
else
    echo f50
fi

#!/bin/sh
# Which device this is: f50 or u30air. The boot's init writes it to /run/mu300/device; without that file (or with
# anything else in it) the device tree tells, the way init decides: only the U30 Air's has the charger policy service.
# (MU300_SYSROOT is for tests: a fake / to read from.)
#   mu300-device          f50 or u30air
#   mu300-device --json   one line of JSON for programs ("ssh root@... mu300-device --json"): the device, the system
#                         that runs, its release, the kernel and whether the caller is root. The fields are a
#                         contract: new fields may be added; "mu300" (the version of this format) changes when one is
#                         taken away or changes meaning.
R=${MU300_SYSROOT:-}
DT=$R/proc/device-tree
device() {
    case $(cat "$R/run/mu300/device" 2>/dev/null) in
        f50) echo f50; return ;;
        u30air) echo u30air; return ;;
    esac
    if [ -d "$DT/charger_policy_service" ]; then echo u30air; else echo f50; fi
}
[ "${1:-}" = --json ] || { device; exit 0; }

DISK=${MU300_DISK:-/mnt/mu300-disk}
# a value as it goes between two quotes: nothing that JSON would want escaped
clean() { tr -cd 'A-Za-z0-9._+-' | cut -c1-64; }
# the system that runs: the directory of the Linux partition that is / (openwrt-luci, or one of the user's own;
# between "mu300-update apply" and the reboot / is the kept copy, NAME.old), else openwrt-luci
system() {
    for d in "$DISK"/*/; do
        d=${d%/}
        [ -d "$d/etc" ] && [ "${R:-/}" -ef "$d" ] || continue
        n=${d##*/}; echo "${n%.old}"; return
    done
    echo openwrt-luci
}
[ "$(id -u)" = 0 ] && root=true || root=false
release=$(cat "$R/etc/mu300/image-version" 2>/dev/null | clean)
printf '{"mu300":1,"device":"%s","system":"%s","version_id":"%s","release":"%s","kernel":"%s","root":%s}\n' \
    "$(device | clean)" "$(system | clean)" \
    "$(sed -n 's/^VERSION_ID="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "$R/etc/os-release" 2>/dev/null | head -n1 | clean)" \
    "${release:-unknown}" "$(uname -r | clean)" "$root"

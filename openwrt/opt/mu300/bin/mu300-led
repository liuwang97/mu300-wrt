#!/bin/sh
# The device's LEDs by what they mean, so the services need not know which device they run on.
#   mu300-led power on|off      Linux is up (set at boot, which also wakes the LEDs; cleared at shutdown); the U30
#                               Air's battery LED comes on with it and goes off at shutdown
#   mu300-led data on|5g|off|error  mobile data connected (5g: over 5G) / not connected / no service (no SIM, not
#                               registered); U30 Air: the colour is the SIM in use, not 4G/5G (below)
#   mu300-led data switching 0|1  U30 Air: a live SIM switch to that slot is under way (mu300-sim-u30): its colour
#                               blinks until the next "data on|5g", or "data off|error" once the switch is over
#   mu300-led wifi on|off|sync [S]  the Wi-Fi hotspot is up (U30 Air: white on 5 GHz, blue on 2.4 GHz); sync: whatever
#                               wlan0 is now, and again every 2 s for S seconds (LuCI or the button)
#   mu300-led events            the Wi-Fi LED follows hostapd on ubus as it comes and goes (a service, no
#                               polling: wifi down/up, LuCI, the panel, a WCN reset, a hostapd that died)
#   mu300-led wake              show the LEDs again, for LED_TIMEOUT seconds (every key press, mu300-sysd); also
#                               in mu300-power's idle, for LED_TIMEOUT (60 s when it is 0): a key always shows life
#   mu300-led sleep [--if-due]  dark now (--if-due: only once the timeout has passed; mu300-sysd asks)
#   mu300-led idle on|off       mu300-power's idle: everything dark whatever LED_TIMEOUT says, except for a key's wake;
#                               state changes are remembered and shown on the next wake or at idle off
#   mu300-led charge on|off     the charging boot: the power LED blinks (1 s on, 1 s off); the U30 Air's battery LED
#                               shows the charge as always
#   mu300-led battery           U30 Air: the battery LED as the battery is now (also at every tick)
#   mu300-led tick              mu300-sysd, when its hint says so: the battery LED, then sleep --if-due
#   mu300-led test              each LED in turn, 2 s each, with its name (to tell which one is where)
#   mu300-led alarm on|off      too hot (mu300-sysd): the PMIC's RGB LED flashes red, white, blue one at a time
#                               like a siren, also while the others are dark (LED_THERMAL: or its red blinks, or nothing)
#   mu300-led boot on|off       the boot indicator, with LED_BOOT=1: the siren's LED takes its colours in turn from
#                               preinit until the boot is done (mu300-post); after 3 minutes it ends by itself
#   mu300-led settings          the settings (below) as one JSON object, with the lamps this device has
#   mu300-led set KEY VALUE     change one setting (timeout, network, wifi, battery, *_brightness, boot, thermal) in
#                               led.conf and show the LEDs by it at once; timeout default: the device's own again
#   mu300-led refresh           every LED again as the settings say
# ZTE F50 (read from its Android): network = the PMIC's RGB LED, blue on 4G, white (its "green" channel) on 5G, red
#   without service; Wi-Fi = the PMIC's keypad backlight sink ("keyboard-backlight"), at ZTE's 48 of 127, whichever
#   band. No power LED. ZTE U30 Air (found by lighting each one):
#   battery  the PMIC's RGB LED: its "green" channel is white, red, blue. As ZTE's firmware: white
#            at 60 % and above, blue from 10 %, red below; steady on the battery, breathing while it charges (the
#            PMIC's own curve, 2 s), steady white when full on the charger. On outside power no LED times out; below
#            10 % on the battery the red one does not either. The heat alarm goes over it.
#   network  as ZTE's firmware: the SIM in use, not the access technology: white for slot 0, the
#            nano-SIM (LDO VDDCAMA0), blue for slot 1, the built-in eSIM (a GPIO, net_blue), red without service
#            (the PMIC's keypad backlight sink, "keyboard-backlight"); the slot is this boot's
#            pin, /run/mu300/sim-slot, so a live switch recolours it
#   Wi-Fi    as ZTE's firmware: white on 5 GHz (LDO VDDCAMA1), blue on 2.4 GHz (LDO VDDCAMA2)
# The LDO ones are zte-ldo0..2 (leds-zte-ldo); the other GPIO LEDs in its device tree (net_red, net_green, net_white,
# pwr_green, wifi_*) light nothing, under Android too.
# The device comes from mu300-device; an LED this device has not is skipped.
#
# Timeout: /etc/mu300/led.conf, LED_TIMEOUT=SECONDS (0: always on). Default 60 on the U30 Air, which has a power
# button to wake them, and 0 on the F50. What each LED should show is kept in /run/mu300/led, so a change while
# the LEDs are dark shows up on the next wake.
# The other settings there (kanoqwq's LED settings; the panel's System > LEDs):
#   LED_NETWORK, LED_WIFI, LED_BATTERY=0|1   that lamp as above (1, the default) or always dark; the heat alarm still
#                                  shows on its LED, and `test` lights everything
#   LED_NETWORK_BRIGHTNESS, LED_WIFI_BRIGHTNESS, LED_BATTERY_BRIGHTNESS=1..100   % of the lamp's usual level (100, the
#                                  default), where the lamp dims: the F50's network and Wi-Fi lamps, the U30 Air's
#                                  battery lamp (the U30 Air's LDO and GPIO lamps only switch: openwrt/docs/power.md)
#   LED_BOOT=0|1                   the boot indicator (0, the default)
#   LED_THERMAL=siren|blink|off    the heat alarm: the siren (the default), the red alone blinking (the kernel's timer,
#                                  200 ms, no process), or nothing. Only the light: mu300-sysd decides when it is hot
#                                  and what is done about it; refresh only reads its /run/mu300/thermal-alarm
# A setting takes effect at once (set runs refresh), and every later run of this script (mu300-sysd's ticks, the
# services' state changes) reads it again.
# Every write is best effort: the PMIC rejects a brightness write now and then (mobile-data), and a cosmetic
# LED must never make a service fail.
# The tick: after each one this leaves $STATE/.tick-hint - every file what the next tick does depends on (the
# battery's and the charger's readings, the state files here), each with what it held, and the uptime from which the
# next tick has something to do even with all of them unchanged (a timeout that runs out; at the latest a minute on).
# mu300-sysd looks at that hint on the charger's and the fuel gauge's uevents and on timers, and asks for ten minutes
# at the latest (MU300_LED_TICK_HINT_MAX=600): it looks every 90 s by itself. A tick that would change nothing is not
# started.
# (MU300_SYSROOT, MU300_BIN and MU300_LED_CONF are for tests: a fake /, this directory, a led.conf)
R=${MU300_SYSROOT:-}
LEDS=$R/sys/class/leds
STATE=$R/run/mu300/led
# rd FILE: its first line into v (- when it cannot be read), by the shell itself
rd() { v=-; { read -r v < "$1"; } 2>/dev/null; }
# The device: the boot's label, when it says u30air, else mu300-device - a script of its own, 2 ms, at every run of
# this one
rd "$R/run/mu300/device"; DEVICE=$v
[ "$DEVICE" = u30air ] || DEVICE=$(${MU300_BIN:-/opt/mu300/bin}/mu300-device)

BY_SIM=0
case $DEVICE in
    u30air) POWER=sc27xx:green DATA=net_blue DATA5G=zte-ldo0 NODATA=keyboard-backlight WIFI5=zte-ldo1 WIFI24=zte-ldo2
            DEFAULT_TIMEOUT=60 BY_SIM=1 ;;   # DATA is slot 1's colour here, DATA5G slot 0's (BY_SIM)
    *)      POWER= DATA=sc27xx:blue DATA5G=sc27xx:green NODATA=sc27xx:red WIFI5=keyboard-backlight
            WIFI24=keyboard-backlight DEFAULT_TIMEOUT=0 ;;
esac
# the PMIC's RGB LED on both (the U30 Air's battery LED, the F50's network LED), one colour at a time: the white
# outshines the others when mixed
SIREN="sc27xx:red sc27xx:green sc27xx:blue"
SIREN_PID=$R/run/mu300/led-siren.pid
BOOT_PID=$R/run/mu300/led-boot.pid
# who writes: nobody in particular (the states), the boot indicator, the heat alarm, or `test`. While the boot indicator
# or the heat alarm runs, the siren's LEDs are theirs (owned); the alarm and `test` light a lamp switched off too.
OWNER=
# the U30 Air's battery LED is the battery's, not a "Linux is up" light: the three PMIC
# channels are drawn by battery_show, never through the state files of the other LEDs
BATTERY_LED=
[ "$DEVICE" != u30air ] || { BATTERY_LED=1; POWER=; }
PSY=$R/sys/class/power_supply
CONF=${MU300_LED_CONF:-/etc/mu300/led.conf}
# led.conf in one read (no process: this runs at every tick); the last line of a key counts, a bad value is ignored
TIMEOUT= ON_network=1 ON_wifi=1 ON_battery=1 PCT_network=100 PCT_wifi=100 PCT_battery=100 BOOT=0 THERMAL=siren
pct_ok() { case $1 in [1-9]|[1-9][0-9]|100) ;; *) return 1 ;; esac; }
if [ -r "$CONF" ]; then
    while IFS= read -r l || [ -n "$l" ]; do
        v=${l#*=}
        case $l in
            LED_TIMEOUT=*) case $v in ''|*[!0-9]*) ;; *) TIMEOUT=$v ;; esac ;;
            LED_NETWORK=[01]) ON_network=$v ;;
            LED_WIFI=[01]) ON_wifi=$v ;;
            LED_BATTERY=[01]) ON_battery=$v ;;
            LED_NETWORK_BRIGHTNESS=*) ! pct_ok "$v" || PCT_network=$v ;;
            LED_WIFI_BRIGHTNESS=*) ! pct_ok "$v" || PCT_wifi=$v ;;
            LED_BATTERY_BRIGHTNESS=*) ! pct_ok "$v" || PCT_battery=$v ;;
            LED_BOOT=[01]) BOOT=$v ;;
            LED_THERMAL=siren|LED_THERMAL=blink|LED_THERMAL=off) THERMAL=$v ;;
        esac
    done < "$CONF"
fi
TIMEOUT_SET=${TIMEOUT:+1}
TIMEOUT=${TIMEOUT:-$DEFAULT_TIMEOUT}
# lamp_of NAME: the lamp that LED is part of, as LAMP, with its switch (ON) and brightness (PCT: 100 where it does not
# dim). The U30 Air's network and Wi-Fi lamps are LDOs and a GPIO with the keypad sink's red among them: on or off.
lamp_of() {
    case $DEVICE:$1 in
        u30air:sc27xx:*) LAMP=battery ON=$ON_battery PCT=$PCT_battery ;;
        u30air:zte-ldo1|u30air:zte-ldo2) LAMP=wifi ON=$ON_wifi PCT=100 ;;
        u30air:*) LAMP=network ON=$ON_network PCT=100 ;;
        *:keyboard-backlight) LAMP=wifi ON=$ON_wifi PCT=$PCT_wifi ;;
        *) LAMP=network ON=$ON_network PCT=$PCT_network ;;
    esac
}
dim() {  # dim LEVEL: DIM, LEVEL at the lamp's PCT (never 0 for a lit one)
    DIM=$1
    case $1 in ''|*[!0-9]*) DIM=0; return 0 ;; esac
    [ "$PCT" = 100 ] || [ "$1" = 0 ] || { DIM=$(( ($1 * PCT + 50) / 100 )); [ "$DIM" -gt 0 ] || DIM=1; }
}

uptime_s() { now; echo "$now"; }
now() { now=0; { read -r now _ < "$R/proc/uptime"; } 2>/dev/null; now=${now%%.*}; }   # the uptime in now
before() {  # before FILE: the uptime in FILE has not come yet
    until=; { read -r until < "$1"; } 2>/dev/null
    case $until in ''|*[!0-9]*) return 1 ;; esac
    now; [ "$now" -lt "$until" ]
}
# on outside power (the U30 Air's charger) nothing times out, as under ZTE's firmware
plugged() { rd "$STATE/.plugged"; [ "$v" = 1 ]; }
awake() { [ "$TIMEOUT" = 0 ] || plugged || before "$STATE/.awake-until"; }
idle() { [ -e "$STATE/.idle" ]; }   # mu300-power's idle: dark, whatever the timeout
# Lit now? Awake as usual; in idle only for a key's wake (.peek-until): a device dark for hours whose keys show
# nothing looks powered off. A key must always show life.
shown() { if idle; then before "$STATE/.peek-until"; else awake; fi; }
has_led() { [ -e "$LEDS/$1" ]; }
level() {  # level NAME: its brightness when lit (ZTE lights the F50's Wi-Fi LED at 48: a low-current sink)
    case $DEVICE:$1 in
        f50:keyboard-backlight) echo 48 ;;
        *) rd "$LEDS/$1/max_brightness"; [ "$v" = - ] || echo "$v" ;;
    esac
}
# boot_running: the boot indicator runs (its pid in BP)
boot_running() { rd "$BOOT_PID"; BP=$v; [ "$BP" != - ] && [ -n "$BP" ] && kill -0 "$BP" 2>/dev/null; }
# owned NAME: one of the siren's LEDs while the heat alarm or the boot indicator has them, and the writer is neither
owned() {
    [ -z "$OWNER" ] || return 1
    case " $SIREN " in *" $1 "*) ;; *) return 1 ;; esac
    [ -e "$STATE/.alarm" ] || boot_running
}
# write NAME 0|1|blink [MS]: the LED itself (blink: the timer trigger, MS (500) on and MS off; steady without one),
# at its lamp's brightness, dark when its lamp is switched off
write() {
    owned "$1" && return 0
    lamp_of "$1"
    case $OWNER in alarm|test) PCT=100 ;; *) [ "$ON" = 1 ] || set -- "$1" 0 ;; esac
    if [ "$2" = blink ]; then
        if [ -w "$LEDS/$1/trigger" ] && echo timer > "$LEDS/$1/trigger" 2>/dev/null; then
            echo "${3:-500}" > "$LEDS/$1/delay_on" 2>/dev/null
            echo "${3:-500}" > "$LEDS/$1/delay_off" 2>/dev/null
            # a dimmed lamp: the brightness written under the timer is the blink's (the kernel's own is the maximum)
            [ "$PCT" = 100 ] || { dim "$(level "$1")"; echo "$DIM" > "$LEDS/$1/brightness" 2>/dev/null; }
            return 0
        fi
        set -- "$1" 1   # no timer trigger: steady
    fi
    [ -w "$LEDS/$1/brightness" ] || return 0
    echo none > "$LEDS/$1/trigger" 2>/dev/null
    if [ "$2" = 1 ]; then dim "$(level "$1")"; echo "$DIM"; else echo 0; fi > "$LEDS/$1/brightness" 2>/dev/null
    return 0
}
set_led() {  # set_led NAME 0|1|blink: what it should show; lit only while awake
    [ -n "$1" ] || return 0
    has_led "$1" || return 0
    { [ -d "$STATE" ] || mkdir -p "$STATE" 2>/dev/null; } && echo "$2" > "$STATE/$1" 2>/dev/null
    if [ "$2" != 0 ] && ! shown; then write "$1" 0; else write "$1" "$2"; fi
}
# The U30 Air's network LED by the SIM in use. The slot is this boot's pin, the file the AT daemons and mobile-data
# read too; it is never created here (that would pin a slot before mu300-modemd chose one).
sim_slot() {
    rd "$R/run/mu300/sim-slot"
    if [ "$v" = 1 ]; then echo 1; else echo 0; fi
}
sim_led() { if [ "$1" = 1 ]; then echo "$DATA"; else echo "$DATA5G"; fi; }   # sim_led SLOT: its colour
network() {  # network NAME|'' VALUE: NAME shows VALUE, the network LED's other colours go dark
    for l in "$NODATA" "$DATA" "$DATA5G"; do [ "$l" = "$1" ] || set_led "$l" 0; done
    [ -z "$1" ] || set_led "$1" "$2"
}
# a live SIM switch's blink stays through the hang-up it causes (netifd tears the old connection down whenever it
# gets to it): only while the switch is still under way, and only one that was announced here
switching() { [ "$BY_SIM" = 1 ] && [ -e "$R/run/mu300/sim-switching" ] && [ -e "$STATE/.switch-to" ]; }
wifi_band() {  # 5 or 2.4: the channel the hotspot runs on, else (it has none yet, just started) its setting
    ch=$(iw dev wlan0 info 2>/dev/null | sed -n 's/.*channel \([0-9]*\).*/\1/p' | head -n1)
    if [ -n "$ch" ]; then [ "$ch" -gt 14 ] && echo 5 || echo 2.4
    else "${MU300_BIN:-/opt/mu300/bin}/mu300-wifi-band" 2>/dev/null | sed -n 's/^hotspot: \([0-9.]*\) GHz$/\1/p'; fi
}
# hostapd's access point on wlan0, as ubus has it: on while its object is there and not DISABLED (one still setting
# up, ACS or a DFS wait, is on its way). iw is no help at that moment: when hostapd's object goes away, iw still
# shows the SSID of the access point being torn down.
hostapd_state() {
    st=$(ubus call hostapd.wlan0 get_status 2>/dev/null | sed -n 's/.*"status": *"\([A-Z_]*\)".*/\1/p' | head -n1)
    case $st in ''|DISABLED) echo off ;; *) echo on ;; esac
}
show_all() {  # every LED as it should be (none while idle, unless a key woke them)
    battery_show
    shown || return 0
    for f in "$STATE"/*; do
        [ -f "$f" ] || continue
        rd "$f"; write "${f##*/}" "$v"
    done
}
# dark_all: every LED dark as the lamps are, not only as this script last wrote them: a lamp can be lit without a state
# file here (the boot's hand-off, a driver that came late, a run cut short), and the battery LED is written again
# rather than taken to be what .battery-shown says. The states are kept.
dark_all() {
    for f in "$STATE"/*; do [ -f "$f" ] && write "${f##*/}" 0; done
    for l in $DATA $DATA5G $NODATA $WIFI5 $WIFI24; do
        [ -e "$STATE/$l" ] || ! has_led "$l" || write "$l" 0
    done
    rm -f "$STATE/.battery-shown"
}
siren_running() { rd "$SIREN_PID"; p=$v; [ "$p" != - ] && [ -n "$p" ] && kill -0 "$p" 2>/dev/null; }

# --- the U30 Air's battery LED: ZTE's services.jar ZteBatteryService and its lights HAL
# ZTE's levels: white (the green channel) 120, blue 200, red 150 of 255
battery_level() { case $1 in green) echo 120 ;; blue) echo 200 ;; red) echo 150 ;; esac; }
# battery_read: "COLOUR MODE LOW PLUGGED" into _br from the fuel gauge (sc27xx-fgu) and the charger (bq256xx-charger);
# false without a capacity. Every file it reads goes
# into the tick's hint with what it held (hint_in), the ones that are not there as "-".
HINT_IN=
hint_in() { HINT_IN="$HINT_IN$1 $v
"; }   # hint_in FILE: FILE held $v (rd FILE just before)
battery_read() {
    _b=
    for _d in "$PSY/sc27xx-fgu"; do [ -r "$_d/capacity" ] && { _b=$_d; break; }; done
    [ -n "$_b" ] || return 1
    rd "$_b/capacity"; hint_in "$_b/capacity"; _cap=$v
    rd "$_b/status"; hint_in "$_b/status"; _st=$v
    case $_cap in ''|*[!0-9]*) return 1 ;; esac
    # outside power: the charger's online flag, when there is one. The gauge says "Charging" for a while after
    # an unplug (kano saw it), so its status alone counts only where no charger says anything
    _on=
    for _d in "$PSY/bq256xx-charger"; do
        rd "$_d/online"; hint_in "$_d/online"
        [ "$v" != - ] || continue
        [ "$v" = 1 ] && { _on=1; break; }
        _on=0
    done
    [ -n "$_on" ] || case $_st in Charging|Full) _on=1 ;; *) _on=0 ;; esac
    if [ "$_cap" -ge 60 ]; then _col=green; elif [ "$_cap" -ge 10 ]; then _col=blue; else _col=red; fi
    _mode=steady; [ "$_on" = 1 ] && [ "$_st" = Charging ] && _mode=breathe
    _low=0; [ "$_on" = 0 ] && [ "$_cap" -lt 10 ] && _low=1
    _br="$_col $_mode $_low $_on"
}
# battery_show: the three channels as .battery says, lit while the LEDs are shown (and, below 10 % on the battery,
# always); written only when that changes, so the breathing is not restarted every tick. The heat alarm and the boot
# indicator own the channels while they run. Switched off (LED_BATTERY=0): dark, the low red too; dimmed: ZTE's
# levels at LED_BATTERY_BRIGHTNESS.
battery_show() {
    [ -n "$BATTERY_LED" ] || return 0
    { [ -e "$STATE/.alarm" ] || siren_running || boot_running; } && return 0
    _bc= _bm= _bl=
    [ ! -r "$STATE/.battery" ] || read -r _bc _bm _bl < "$STATE/.battery"
    _bw=off
    if [ -n "$_bc" ] && [ "$ON_battery" = 1 ] && [ ! -e "$STATE/.battery-off" ] && { [ "$_bl" = 1 ] || shown; }; then
        _bw="$_bc $_bm"
    fi
    v=; { read -r v < "$STATE/.battery-shown"; } 2>/dev/null
    [ "$_bw" != "$v" ] || return 0
    PCT=$PCT_battery
    for _c in red green blue; do
        [ -w "$LEDS/sc27xx:$_c/brightness" ] || continue
        dim "$(battery_level $_c)"
        if [ "$_bw" = "$_c steady" ]; then write_level "sc27xx:$_c" "$DIM"
        elif [ "$_bw" = "$_c breathe" ]; then breathe "sc27xx:$_c" "$DIM"
        else write "sc27xx:$_c" 0; fi
    done
    mkdir -p "$STATE" 2>/dev/null && echo "$_bw" > "$STATE/.battery-shown"
}
write_level() {  # write_level NAME LEVEL: steady at LEVEL
    echo none > "$LEDS/$1/trigger" 2>/dev/null
    echo "$2" > "$LEDS/$1/brightness" 2>/dev/null
    return 0
}
# breathe NAME LEVEL: ZTE's charging light, 800 ms on and 1200 ms off, which its HAL hands the PMIC as a curve:
# rise 2/5 of on, high 3/5, fall 2/5 of off, low 3/5 (the pattern trigger's hw_pattern); a timer blink without it
# From a steady light the brightness goes to 0 first: the SC27xx's pattern_set sets RUN without clearing the steady
# TYPE bit, and the pattern trigger's switch does not always call pattern_clear, so the LED stayed steady with both
# bits set (0x300 in the PMIC's 0x180 on a U30 Air; 0x100 with this). A channel already on the pattern
# trigger is left as it is.
breathe() {
    if grep -qw pattern "$LEDS/$1/trigger" 2>/dev/null; then
        if ! grep -q '\[pattern\]' "$LEDS/$1/trigger" 2>/dev/null; then
            echo 0 > "$LEDS/$1/brightness" 2>/dev/null
            echo pattern > "$LEDS/$1/trigger" 2>/dev/null
        fi
        echo -1 > "$LEDS/$1/repeat" 2>/dev/null
        echo "$2 320 $2 480 $2 480 $2 720" > "$LEDS/$1/hw_pattern" 2>/dev/null && return 0
    fi
    echo timer > "$LEDS/$1/trigger" 2>/dev/null
    echo 800 > "$LEDS/$1/delay_on" 2>/dev/null
    echo 1200 > "$LEDS/$1/delay_off" 2>/dev/null
    echo "$2" > "$LEDS/$1/brightness" 2>/dev/null
    return 0
}
# battery_update: read the battery, remember it, and show it. Unplugged: the timeout starts again from now (ZTE's
# 15 s after an unplug; LED_TIMEOUT here); plugged in: everything lit, and it stays lit.
battery_update() {
    [ -n "$BATTERY_LED" ] || return 0
    battery_read || return 0
    [ -d "$STATE" ] || mkdir -p "$STATE" 2>/dev/null || return 0
    rd "$STATE/.plugged"; _was=$v
    _p=${_br##* }
    echo "$_p" > "$STATE/.plugged"
    echo "${_br% *}" > "$STATE/.battery"
    if [ "$_was" = 1 ] && [ "$_p" = 0 ] && [ "$TIMEOUT" != 0 ]; then
        now; echo $(( now + TIMEOUT )) > "$STATE/.awake-until"
    fi
    if [ "$_p" = 1 ] && [ "$_was" != 1 ]; then show_all; else battery_show; fi
}
# leds_sleep [--if-due]: dark now, or (--if-due, the tick) only once the timeout has passed
leds_sleep() {
    if idle; then   # a key's wake in idle: dark again once it is over
        if [ "${1:-}" = --if-due ] && shown; then return 0; fi
        [ -e "$STATE/.peek-until" ] || [ "${1:-}" != --if-due ] || return 0   # dark already
        rm -f "$STATE/.peek-until"
    else
        [ "$TIMEOUT" = 0 ] && return 0
        if [ "${1:-}" = --if-due ] && awake; then return 0; fi
        [ -e "$STATE/.awake-until" ] || [ "${1:-}" != --if-due ] || return 0   # dark already
    fi
    rm -f "$STATE/.awake-until"
    dark_all
    battery_show
}
# tick_hint: what the next tick depends on, for mu300-sysd (see the top): "due UPTIME", then "FILE VALUE" lines
# (the battery's files battery_read saw, the state files here, the siren's and the boot indicator's pid files). The due time is when a timeout
# runs out (.peek-until in idle; .awake-until while the LEDs time out and the device is not on outside power; a value
# that is not a number: now), and a minute from now at the latest, so whatever this does not foresee is still caught.
TICK_HINT_MAX=${MU300_LED_TICK_HINT_MAX:-60}
tick_hint() {
    [ -d "$STATE" ] || return 0
    _hi=$HINT_IN
    for _h in .plugged .battery .battery-shown .battery-off .idle .peek-until .awake-until .alarm; do
        rd "$STATE/$_h"; _hi="$_hi$STATE/$_h $v
"
        case $_h in .idle) _idle=$v ;; .peek-until) _peek=$v ;; .awake-until) _awake=$v ;; .plugged) _plg=$v ;; esac
    done
    rd "$SIREN_PID"; _hi="$_hi$SIREN_PID $v
"
    rd "$BOOT_PID"; _hi="$_hi$BOOT_PID $v
"
    now; _due=$((now + TICK_HINT_MAX))
    if [ "$_idle" != - ]; then _u=$_peek
    elif [ "$TIMEOUT" = 0 ] || [ "$_plg" = 1 ]; then _u=-
    else _u=$_awake; fi
    case $_u in -) ;; ''|*[!0-9]*) _due=0 ;; *) [ "$_u" -ge "$_due" ] || _due=$_u ;; esac
    printf 'due %s\n%s' "$_due" "$_hi" > "$STATE/.tick-hint" 2>/dev/null
}
# nap SECONDS: also a fraction where the system's sleep takes none: usleep (the bundled busybox's), else a second
nap() {
    sleep "$1" 2>/dev/null && return 0
    _nw=${1%%.*} _nf=; case $1 in *.*) _nf=${1#*.} ;; esac
    _nf=${_nf}000000; _nf=${_nf%"${_nf#??????}"}
    _nu=$(( ${_nw:-0} * 1000000 + 1$_nf - 1000000 ))
    usleep "$_nu" 2>/dev/null || "${MU300_BIN:-/opt/mu300/bin}/busybox" usleep "$_nu" 2>/dev/null || sleep 1
}
# turns PIDFILE SECONDS [UNTIL]: the siren's LEDs one colour at a time, SECONDS each, for as long as PIDFILE names this
# process (the siren, the boot indicator), and until the uptime UNTIL when given (then it returns). One left behind
# (switched off while it was between writes, a restarted service) stops by itself instead of flashing along with the
# new one. The file is written just after the start, so a missing one counts only after the first round.
turns() {
    n=0
    while :; do
        rd "$1"; own=$v; [ "$own" != - ] || own=
        if [ -n "$own" ]; then [ "$own" = $$ ] || exit 0
        elif [ $n -gt 0 ]; then exit 0; fi
        n=$((n + 1))
        [ -z "${3:-}" ] || { now; [ "$now" -lt "$3" ]; } || return 0
        for on in $SIREN; do
            for l in $SIREN; do [ "$l" = "$on" ] || write "$l" 0; done
            write "$on" 1; nap "$2"
        done
    done
}
# conf_set KEY [VALUE]: led.conf with KEY set to VALUE (none: taken out), the other lines as they were, written whole
# and renamed over the old one
conf_set() {
    mkdir -p "${CONF%/*}" 2>/dev/null
    { grep -v "^$1=" "$CONF" 2>/dev/null; [ -z "${2:-}" ] || echo "$1=$2"; } > "$CONF.new" &&
        chmod 644 "$CONF.new" && mv -f "$CONF.new" "$CONF"
}
jbool() { if [ "$1" = 1 ]; then printf true; else printf false; fi; }

case "$1 ${2:-}" in
    "power on")   set_led "$POWER" 1; rm -f "$STATE/.battery-off"; battery_update
                  [ "$TIMEOUT" = 0 ] || idle || exec "$0" wake ;;   # (a boot, not a key)
    "power off")  set_led "$POWER" 0
                  [ -z "$BATTERY_LED" ] || { mkdir -p "$STATE" 2>/dev/null; : > "$STATE/.battery-off"; battery_show; } ;;
    "battery "*)  battery_update ;;
    "tick "*)     battery_update; leds_sleep --if-due; tick_hint ;;
    "data on"|"data 5g")
        rm -f "$STATE/.switch-to"
        if [ "$BY_SIM" = 1 ]; then network "$(sim_led "$(sim_slot)")" 1
        elif [ "$2" = 5g ]; then network "$DATA5G" 1
        else network "$DATA" 1; fi ;;
    "data off"|"data error")
        switching && exit 0
        rm -f "$STATE/.switch-to"
        if [ "$2" = error ]; then network "$NODATA" 1; else network '' 0; fi ;;
    "data switching")
        [ "$BY_SIM" = 1 ] || exit 0   # (no other device switches SIMs live)
        case ${3:-} in 0|1) ;; *) echo "mu300-led data switching: the slot is 0 or 1" >&2; exit 2 ;; esac
        mkdir -p "$STATE" 2>/dev/null && echo "$3" > "$STATE/.switch-to" 2>/dev/null
        network "$(sim_led "$3")" blink ;;
    "wifi on")
        if [ "$WIFI5" = "$WIFI24" ]; then set_led "$WIFI5" 1
        elif [ "$(wifi_band)" = 5 ]; then set_led "$WIFI24" 0; set_led "$WIFI5" 1
        else set_led "$WIFI5" 0; set_led "$WIFI24" 1; fi ;;
    "wifi off")   set_led "$WIFI5" 0; [ "$WIFI24" = "$WIFI5" ] || set_led "$WIFI24" 0 ;;
    "wifi sync")  # a running AP has its SSID in iw's answer; a stopped hostapd leaves "type AP" without one
        # (a hotspot that LuCI turned on can take longer than any one moment to come up: S follows it a while)
        n=${3:-0} last=
        case $n in ''|*[!0-9]*) n=0 ;; esac
        while :; do
            if iw dev wlan0 info 2>/dev/null | grep -q '^[[:space:]]*type AP' &&
               iw dev wlan0 info 2>/dev/null | grep -q '^[[:space:]]*ssid '; then s=on; else s=off; fi
            [ "$s" = "$last" ] || { "$0" wifi "$s"; last=$s; }
            [ "$n" -gt 0 ] || break
            nap 2; n=$((n - 2))
        done ;;
    "events "*)
        # ubusd announces every object it adds and removes, and hostapd.wlan0 is there exactly while hostapd runs
        # the access point. The state is read once the listener is up (nothing in between is missed), then at each
        # of its events. The data LED stays mobile-data's (the dial, the hang-up, its watchdog).
        command -v ubus >/dev/null 2>&1 || { echo "mu300-led events: needs ubus (OpenWrt)" >&2; exit 1; }
        ubus listen ubus.object.add ubus.object.remove | {
            last=$(hostapd_state); "$0" wifi "$last"
            while IFS= read -r ev; do
                case $ev in *'"hostapd.wlan0"'*) ;; *) continue ;; esac
                s=$(hostapd_state)
                [ "$s" = "$last" ] || { "$0" wifi "$s"; last=$s; }
            done
        } ;;
    "wake "*)
        mkdir -p "$STATE" 2>/dev/null
        now
        if idle; then   # idle: lit for the timeout all the same (a minute where there is none), then dark again
            t=$TIMEOUT; [ "$t" != 0 ] || t=60
            echo $((now + t)) > "$STATE/.peek-until"
        fi
        [ "$TIMEOUT" = 0 ] || echo $((now + TIMEOUT)) > "$STATE/.awake-until"
        show_all ;;
    "sleep "*)    leds_sleep "${2:-}" ;;
    "idle on")
        mkdir -p "$STATE" 2>/dev/null
        : > "$STATE/.idle"
        rm -f "$STATE/.peek-until"
        dark_all
        [ -z "$POWER" ] || write "$POWER" 0
        battery_show ;;
    "idle off")
        rm -f "$STATE/.idle" "$STATE/.peek-until"
        if awake; then show_all; fi ;;   # past the timeout they stay dark until the next wake
    "charge on")
        # the U30 Air: its battery LED breathes while it charges anyway (battery_update)
        [ -z "$BATTERY_LED" ] || { battery_update; exit 0; }
        [ -n "$POWER" ] && [ -w "$LEDS/$POWER/trigger" ] || exit 0
        echo timer > "$LEDS/$POWER/trigger" 2>/dev/null
        echo 1000 > "$LEDS/$POWER/delay_on" 2>/dev/null
        echo 1000 > "$LEDS/$POWER/delay_off" 2>/dev/null ;;
    "charge off")
        [ -z "$BATTERY_LED" ] || { battery_update; exit 0; }
        [ -n "$POWER" ] && [ -w "$LEDS/$POWER/trigger" ] || exit 0
        echo none > "$LEDS/$POWER/trigger" 2>/dev/null
        write "$POWER" 0
        if awake; then show_all; fi ;;
    "alarm on")
        # .alarm: the siren's LEDs are the alarm's (owned), whichever way it shows; the boot indicator gives way
        [ "$THERMAL" != off ] || exit 0
        mkdir -p "$STATE" 2>/dev/null && : > "$STATE/.alarm"
        if boot_running; then kill "$BP" 2>/dev/null; rm -f "$BOOT_PID"; fi
        OWNER=alarm
        if [ "$THERMAL" = blink ]; then
            for l in $SIREN; do write "$l" 0; done
            write "${SIREN%% *}" blink 200   # the red one
            exit 0
        fi
        siren_running && exit 0
        mkdir -p "${SIREN_PID%/*}" 2>/dev/null
        "$0" siren </dev/null >/dev/null 2>&1 &
        echo $! > "$SIREN_PID" ;;
    "alarm off")
        [ -e "$STATE/.alarm" ] || siren_running || { rm -f "$SIREN_PID"; exit 0; }
        rm -f "$STATE/.alarm"
        siren_running && kill "$p" 2>/dev/null
        rm -f "$SIREN_PID"
        nap 0.2
        for l in $SIREN; do write "$l" 0; done
        rm -f "$STATE/.battery-shown"    # the alarm drew over it
        show_all ;;   # the U30 Air's white is its power LED, the F50's colours its network LED
    "siren "*)    OWNER=alarm; turns "$SIREN_PID" 0.25 ;;   # (alarm on runs this in the background)
    "boot on")
        [ "$BOOT" = 1 ] || exit 0
        [ ! -e "$STATE/.alarm" ] || exit 0   # the heat alarm goes first
        boot_running && exit 0
        mkdir -p "$STATE" 2>/dev/null
        "$0" chase </dev/null >/dev/null 2>&1 &
        echo $! > "$BOOT_PID" ;;
    "boot off")   # also with LED_BOOT=0: one that a change of the setting left running ends too
        boot_running || { rm -f "$BOOT_PID"; exit 0; }
        [ "$BP" = $$ ] || kill "$BP" 2>/dev/null   # (the boot indicator's own end: it is this process now)
        rm -f "$BOOT_PID"
        [ "$BP" = $$ ] || nap 0.2
        for l in $SIREN; do write "$l" 0; done
        rm -f "$STATE/.battery-shown"
        show_all ;;
    "chase "*)   # (boot on runs this in the background) kanoqwq's tempo: 120 ms a colour on the F50, 250 ms on the U30 Air
        OWNER=boot
        if [ "$DEVICE" = f50 ]; then t=0.12; else t=0.25; fi
        now; turns "$BOOT_PID" "$t" $((now + 180))
        exec "$0" boot off ;;   # 3 minutes: a boot that never said it was done
    "settings "*)
        case $DEVICE in
            u30air) lamps='"network","wifi","battery"' dims='"battery"' ;;
            *)      lamps='"network","wifi"' dims='"network","wifi"' ;;
        esac
        case $DEVICE in ''|*[!a-z0-9_-]*) d=unknown ;; *) d=$DEVICE ;; esac
        t=$(echo "$TIMEOUT" | sed 's/^0*\([0-9]\)/\1/')   # (a JSON number: "060" in led.conf is 60)
        printf '{"device":"%s","lamps":[%s],"dimmable":[%s],"timeout":%s,"timeout_default":%s,"default_timeout":%s,' \
            "$d" "$lamps" "$dims" "$t" "$(if [ -n "$TIMEOUT_SET" ]; then printf false; else printf true; fi)" "$DEFAULT_TIMEOUT"
        printf '"network":%s,"network_brightness":%s,"wifi":%s,"wifi_brightness":%s,"battery":%s,"battery_brightness":%s,' \
            "$(jbool "$ON_network")" "$PCT_network" "$(jbool "$ON_wifi")" "$PCT_wifi" "$(jbool "$ON_battery")" "$PCT_battery"
        printf '"boot":%s,"thermal":"%s"}\n' "$(jbool "$BOOT")" "$THERMAL" ;;
    "set "*)
        v=${3:-}
        case $2 in
            timeout) k=LED_TIMEOUT
                     case $v in default) v= ;; *[!0-9]*|''|0?*) v=bad ;; *) [ "${#v}" -le 5 ] && [ "$v" -le 86400 ] || v=bad ;; esac ;;
            network|wifi|battery) k=LED_$(echo "$2" | tr a-z A-Z); case $v in 0|1) ;; *) v=bad ;; esac ;;
            network_brightness|wifi_brightness|battery_brightness)
                k=LED_$(echo "$2" | tr a-z A-Z); pct_ok "$v" || v=bad ;;
            boot) k=LED_BOOT; case $v in 0|1) ;; *) v=bad ;; esac ;;
            thermal) k=LED_THERMAL; case $v in siren|blink|off) ;; *) v=bad ;; esac ;;
            *) echo "mu300-led set: no setting \"$2\" (timeout, network, wifi, battery, network_brightness," \
                    "wifi_brightness, battery_brightness, boot, thermal)" >&2; exit 2 ;;
        esac
        [ "$v" != bad ] || { echo "mu300-led set $2: not a value for it: \"${3:-}\"" >&2; exit 2; }
        conf_set "$k" "$v" || { echo "mu300-led set: could not write $CONF" >&2; exit 1; }
        if [ "$k" = LED_TIMEOUT ]; then exec "$0" wake; fi   # (the new timeout from now)
        exec "$0" refresh ;;
    "refresh "*)
        # the heat alarm as mu300-sysd has it (its file, only read) in the way LED_THERMAL says now; a boot
        # indicator switched off ends; every lamp at its switch and brightness
        "$0" alarm off
        [ ! -e "$R/run/mu300/thermal-alarm" ] || "$0" alarm on
        [ "$BOOT" = 1 ] || "$0" boot off
        rm -f "$STATE/.battery-shown"
        show_all ;;
    "test "*)
        OWNER=test
        for l in "$LEDS"/*; do
            n=${l##*/}
            case $DEVICE:$n in *:mmc*) continue ;; f50:keyboard-backlight) ;; *:*backlight*) continue ;; esac
            old=$(cat "$l/brightness" 2>/dev/null)
            echo "$n"; write "$n" 1; sleep 2; echo "${old:-0}" > "$l/brightness" 2>/dev/null
        done ;;
    *) sed -n '2,30s/^# \{0,1\}//p' "$0" >&2; exit 2 ;;
esac
exit 0

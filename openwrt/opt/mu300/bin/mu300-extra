#!/bin/sh
# Optional parts that are not in the image, downloaded when you want them.
#   mu300-extra list              what there is, and what is installed
#   mu300-extra status [NAME]     the installed extras: release, size, commands
#   mu300-extra install NAME      download it, check it against its release's SHA256SUMS, install it and put its
#                                 commands on the PATH (vpn and its engines vpn-xray, vpn-singbox, vpn-mihomo,
#                                 vpn-dae: the latest release of the VPN module, github.com/dikeckaan/mu300-linux-vpn).
#                                 vpn brings the engines the profiles need along (and, the first time,
#                                 MU300_VPN_ENGINES, default vpn-xray), all or nothing
#   mu300-extra install vpn|vpn-ENGINE --from FILE|DIR   offline: the module's tarball copied onto the device, or a
#                                 directory with the tarballs and their SHA256SUMS (then they are verified)
#   mu300-extra install audio [--from FILE|DIR]   call audio: the latest release of github.com/dikeckaan/mu300-audio for
#                                 this kernel series (mu300-audio-KERNEL.tar.gz, checked against its
#                                 SHA256SUMS), linked into every system, and the DSP firmware fetched along (pinned
#                                 sha256). Offline: DIR with the tarball, SHA256SUMS and agdsp.bin. MU300_AUDIO_FIRMWARE=
#                                 none fetches no firmware, =FILE installs your own image instead
#   mu300-extra install NAME --from FILE|DIR   an extra of your own (any other NAME): a tarball copied onto the device
#                                 with ./name (NAME), ./release, ./manifest (sha256sum lines of every other file) and
#                                 programs in ./bin; its hooks/link and hooks/unlink (optional) run for every system, as
#                                 the VPN module's do. DIR: a directory with NAME.tar.gz and a SHA256SUMS that lists it.
#                                 Never downloaded, never updated, and not listed: list and status show the extras of
#                                 the releases (mu300-extra status NAME shows one of yours)
#   mu300-extra remove NAME [--force]   (--force: the vpn extra, or an engine, even while the VPN is on with it)
#   mu300-extra link              put the system's commands and the extras' on the PATH, and link the VPN module
#                                 into this system (its hooks/link; run at every boot)
#
# Extras live on the Linux partition (/mnt/mu300-disk/extra/NAME), not in a system: an update or reinstall of the
# system keeps them. mu300-update apply brings them up to date.
# There are:
#   vpn         the VPN toolkit: mu300-vpn, the module of github.com/dikeckaan/mu300-linux-vpn. Installing it links it
#               into every installed system (the images have no mu300-vpn); removing it takes it out of them again.
#   vpn-xray, vpn-singbox, vpn-mihomo, vpn-dae   the VPN's engines (Xray-core with hev-socks5-tunnel, sing-box,
#               mihomo, dae), each on its own, from the same module repository (mu300-vpn engine install NAME)
#   audio       call audio: the Unisoc audio DSP's drivers for one kernel series, mu300-audio-dsp, mu300-voice and
#               their services, the module of github.com/dikeckaan/mu300-audio. Removing it takes it out of every system
#               again (and the firmware it had put there).
#
# MU300_VPN_URL=URL another place for the VPN module (a pinned tag: .../releases/download/v1.0.0), MU300_VPN_MODULE
# the same as --from, MU300_AUDIO_URL and MU300_AUDIO_MODULE the same for the audio extra, MU300_EXTRA_FILE=FILE the
# same as --from for an extra of your own.
# The download, the checks and the installation are mu300-update's own (fetch_verified, module_get, extra_unpack).
BIN=${MU300_BIN:-/opt/mu300/bin}
_lib=${MU300_LIB:-}
MU300_LIB=1
. "$BIN/mu300-update"
MU300_LIB=$_lib
STAGE=$DISK/.mu300-extra
OPT=${MU300_OPT:-/opt/mu300}
SYSROOT=${MU300_SYSROOT:-}

# where commands go: a directory on everybody's PATH (busybox's PATH has no /usr/local)
link_dir() { echo "${MU300_LINKDIR:-/usr/bin}"; }

# link: the system's commands (one list, the same the images are built with) and every installed extra's. A file
# or a link of somebody else's is never replaced; a link into an extra that is gone is removed.
do_link() { do_link_commands; do_link_modules; }
do_link_commands() {
    L=$(link_dir)
    mkdir -p "$L"
    if [ -r "$OPT/lib/path-commands" ]; then
        for c in $(cat "$OPT/lib/path-commands"); do
            [ -x "$OPT/bin/$c" ] || continue
            [ -e "$L/$c" ] || [ -L "$L/$c" ] || ln -s "$OPT/bin/$c" "$L/$c" 2>/dev/null || true
        done
    fi
    for x in $(extra_installed); do
        for f in "$EXTRA/$x"/bin/*; do
            [ -x "$f" ] || continue
            c=${f##*/}
            if [ -L "$L/$c" ]; then
                case $(readlink "$L/$c") in "$EXTRA"/*) ln -sfn "$f" "$L/$c" ;; esac
            elif [ ! -e "$L/$c" ]; then
                ln -s "$f" "$L/$c" 2>/dev/null || true
            fi
        done
    done
    for l in "$L"/*; do
        [ -L "$l" ] && [ ! -e "$l" ] || continue
        case $(readlink "$l") in "$EXTRA"/*) rm -f "$l" ;; esac
    done
}
# the VPN module into this system: a new image has none of it (the boot after an update or a reinstall)
do_link_modules() {
    for x in $(extra_installed); do
        extra_is_module "$x" || extra_own "$x" || continue
        module_hook_fits "$x" link "$SYSROOT" "$(system_release)" || true
    done
    return 0
}

need_root() { [ "$(id -u)" = 0 ] || die "run as root (mu300-extra $*)"; }
need_disk() { [ -n "$(installed_systems)" ] || die "the Linux partition is not mounted at $DISK"; }
known() { extra_known "$1" || die "there is no extra called '$1' (mu300-extra list)"; }

# the release of this system (what a module's ./requires is held to)
system_release() {
    v=$(cat "$SYSROOT/etc/mu300/image-version" 2>/dev/null)
    case $v in v[0-9]*) echo "$v" ;; esac
}

# dae_kernel_ok: the running kernel can run dae - it has BTF (/sys/kernel/btf/vmlinux); else the reason on stdout
# and 1. (MU300_KREL, MU300_BTF: tests/)
dae_kernel_ok() {
    _kr=${MU300_KREL:-$(uname -r 2>/dev/null)}
    [ -r "${MU300_BTF:-/sys/kernel/btf/vmlinux}" ] && return 0
    echo "dae needs a kernel with BTF (/sys/kernel/btf/vmlinux), and kernel $_kr has none"
    return 1
}

# install vpn|vpn-ENGINE [FROM]: the module, from FROM (a file, or a directory with SHA256SUMS) or its latest release.
# vpn is the core with the engines the device needs (vpn_module_get): the engines first, the core last, and nothing
# of the core changes when an engine cannot be had or installed.
do_install_module() {
    name=$1
    from=${2:-${MU300_VPN_MODULE:-}}
    # dae is 33 MB of program and 25 MB of geodata that a kernel without BTF cannot run:
    # said before anything is downloaded (MU300_DAE_ANY_KERNEL=1: for a kernel this device is about to boot)
    if [ "$name" = vpn-dae ] && [ "${MU300_DAE_ANY_KERNEL:-}" != 1 ] && ! why_=$(dae_kernel_ok); then
        die "vpn-dae was not installed: $why_ (MU300_DAE_ANY_KERNEL=1 installs it anyway, for a kernel this device is about to boot)"
    fi
    if [ "$name" != vpn ]; then
        [ -n "$from" ] || say "downloading $(module_asset "$name") from $VPN_URL"
        module_get "$name" "$STAGE" "$from"; r=$?
        case $r in
            0) set_="$name $MODULE_FILE $MODULE_SHA" ;;
            3) set_= ;;
            1) rm -rf "$STAGE"; die "$name was not installed: the VPN module could not be downloaded ($(offline_why); offline: mu300-extra install $name --from DIR, a directory with $(module_asset "$name") and the release's SHA256SUMS copied onto the device)" ;;
            *) rm -rf "$STAGE"; die "$name was not installed" ;;
        esac
    else
        [ -n "$from" ] || say "downloading the VPN module and the engines it needs ($(vpn_engines_wanted | tr '\n' ' ' | sed 's/ $//')) from $VPN_URL"
        vpn_module_get "$STAGE" "$from"; r=$?
        case $r in
            0) set_=$VPN_SET ;;
            1) rm -rf "$STAGE"; die "vpn was not installed: the VPN module could not be downloaded ($(offline_why); offline: mu300-extra install vpn --from DIR, a directory with the module's tarballs and SHA256SUMS)" ;;
            4) rm -rf "$STAGE"; die "vpn was not installed, and nothing was changed: the engines this device runs on must come with it (see above; offline: the engine tarballs, or mu300-linux-vpn.tar.gz, next to the core)" ;;
            *) rm -rf "$STAGE"; die "vpn was not installed" ;;
        esac
    fi
    [ -n "$set_" ] || echo "$name $(extra_release "$name") is the latest release already"
    done_=; bad_=
    while read -r n_ f_ s_; do
        [ -n "$n_" ] || continue
        [ "$n_" != vpn ] || [ -z "$bad_" ] || { rm -rf "$STAGE"; die "vpn was not installed: its engine$bad_ could not be installed (see above); the installed VPN module is unchanged"; }
        if module_install "$n_" "$f_" "$s_" "$(system_release)"; then
            done_="$done_ $n_"
        else
            [ "$n_" != vpn ] || { rm -rf "$STAGE"; die "vpn was not installed"; }
            [ "$name" = vpn ] || { rm -rf "$STAGE"; die "$name was not installed"; }
            vpn_engine_have "$n_" || bad_="$bad_ $n_"
            echo "$n_ was not installed (see above)" >&2
        fi
    done <<EOF
$set_
EOF
    rm -rf "$STAGE"
    module_vdir_clean
    do_link_commands
    # the engines first: their hook starts a VPN that waits for them, which the core's link would otherwise start
    # without them
    for n_ in $done_; do [ "$n_" = vpn ] || [ "$n_" = "$name" ] || module_hook_all "$n_" link || true; done
    module_hook_all "$name" link || echo "$name: a system it could not be linked into gets it at its next boot (mu300-extra link)" >&2
    # the panel's VPN menu appears with the module (its mu300-vpn is in the extra now)
    [ "$name" != vpn ] || luci_menu_refresh
    for n_ in $done_; do [ "$n_" = "$name" ] || printf '%s %s installed in %s\n' "$n_" "$(extra_release "$n_")" "$EXTRA/$n_"; done
    printf '%s %s installed in %s\n' "$name" "$(extra_release "$name")" "$EXTRA/$name"
}

# install audio [FROM]: the audio extra of this kernel series, from FROM (a file, or a directory with
# SHA256SUMS) or its latest release, with the DSP firmware (audio_firmware: before the systems are linked, so
# hooks/link finds it); the firmware is never fatal, the extra is
do_install_audio() {
    from=${1:-${MU300_AUDIO_MODULE:-}}
    [ -n "$from" ] || say "downloading $(module_asset audio) (call audio for kernel $KERNEL_SERIES) from $AUDIO_URL"
    audio_get "$STAGE" "$from"; r=$?
    case $r in
        0|3) ;;
        1) rm -rf "$STAGE"; die "audio was not installed: the audio extra could not be downloaded ($(offline_why); offline: mu300-extra install audio --from DIR, a directory with $(module_asset audio), the release's SHA256SUMS and agdsp.bin copied onto the device)" ;;
        *) rm -rf "$STAGE"; die "audio was not installed" ;;
    esac
    [ "$r" = 0 ] || echo "audio $(extra_release audio) for kernel $KERNEL_SERIES is the latest release already"
    _mf=$MODULE_FILE _ms=$MODULE_SHA
    audio_firmware "$from"
    if [ "$r" = 0 ]; then
        module_install audio "$_mf" "$_ms" "$(system_release)" || { rm -rf "$STAGE"; module_vdir_clean; die "audio was not installed"; }
    fi
    rm -rf "$STAGE"
    module_vdir_clean
    do_link_commands
    module_hook_all audio link || echo "audio: a system it could not be linked into gets it at its next boot (mu300-extra link)" >&2
    printf 'audio %s (kernel %s) installed in %s\n' "$(extra_release audio)" "$(cat "$EXTRA/audio/kernel" 2>/dev/null)" "$EXTRA/audio"
    for _o in $(installed_systems); do
        [ -f "$DISK/$_o/lib/firmware/agdsp.bin" ] || echo "note: $_o has no DSP firmware: the DSP stays down there (mu300-audio-dsp install FILE|--download)"
    done
    echo "the sound card and the DSP start now in the background, and at every boot (mu300-audio-dsp status)"
}

# own_from NAME FILE|DIR: OWN_FILE, an extra of the user's own. A directory must hold NAME.tar.gz and a SHA256SUMS that
# lists it; a file is checked against a SHA256SUMS next to it when that lists it (else it is the user's own choice).
own_from() {
    OWN_FILE=
    if [ -d "$2" ]; then
        _w=$(sums_want "$2/SHA256SUMS" "$1.tar.gz")
        [ -s "$2/$1.tar.gz" ] || { echo "no $1.tar.gz in $2" >&2; return 1; }
        [ -n "$_w" ] || { echo "$2/SHA256SUMS is missing or does not list $1.tar.gz: not installed unverified" >&2; return 1; }
        [ "$(sha_of "$2/$1.tar.gz")" = "$_w" ] || { echo "$2/$1.tar.gz does not match its SHA256SUMS" >&2; return 1; }
        OWN_FILE=$2/$1.tar.gz
        return 0
    fi
    [ -s "$2" ] || { echo "$2 not found" >&2; return 1; }
    _w=$(sums_want "$(dirname "$2")/SHA256SUMS" "${2##*/}")
    [ -z "$_w" ] || [ "$(sha_of "$2")" = "$_w" ] || { echo "$2 does not match $(dirname "$2")/SHA256SUMS" >&2; return 1; }
    OWN_FILE=$2
}

# install_own NAME FILE|DIR: an extra of the user's own (extra_own), from a file on this device only
install_own() {
    own_from "$1" "$2" || die "$1 was not installed"
    extra_unpack "$1" "$OWN_FILE" "$(system_release)" || die "$1 was not installed"
    rm -f "$EXTRA/.$1.sha256"
    do_link_commands
    module_hook_all "$1" link || echo "$1: a system it could not be linked into gets it at its next boot (mu300-extra link)" >&2
    printf '%s %s installed in %s\n' "$1" "$(extra_release "$1")" "$EXTRA/$1"
}

do_install() {
    name=$1
    if ! extra_known "$name"; then
        install_own "$name" "${2:-${MU300_EXTRA_FILE:-}}"
        return
    fi
    if [ "$name" = audio ]; then
        [ -z "${MU300_EXTRA_FILE:-}" ] || die "MU300_EXTRA_FILE is not for the audio extra: mu300-extra install audio --from FILE|DIR"
        do_install_audio "${2:-}"
        return
    fi
    do_install_module "$name" "${2:-}"
}
# luci_menu_refresh: the panel's VPN menu (OpenWrt) depends on the module's mu300-vpn in the extra (menu.d, "fs");
# LuCI checks that when it builds its index cache, and the cache is keyed on the menu files alone - so the cache
# goes when the module comes or goes, and the next request builds it again (a reboot clears /tmp anyway)
luci_menu_refresh() {
    rm -f "$SYSROOT"/tmp/luci-indexcache "$SYSROOT"/tmp/luci-indexcache.* 2>/dev/null
    return 0
}

do_remove() {
    [ -d "$EXTRA/$1" ] || { echo "$1 is not installed"; return 0; }
    # a VPN that is on loses its tunnel, and (kill switch up) the device its connection, until they are back
    if [ "$1" = vpn ] && [ "${2:-}" != --force ] && extra_vpn_wanted "$SYSROOT"; then
        echo "the VPN is on (ENABLE=1 in /etc/mu300/vpn.conf): turn it off first (mu300-toolkit, or ENABLE=0 and mu300-vpn off), or: mu300-extra remove vpn --force" >&2
        return 1
    fi
    # an engine the VPN runs on now: the kill switch would stay up with nothing behind it (it fails closed, and the
    # service would fetch the engine again)
    if [ "$1" != vpn ] && extra_is_module "$1" && [ "${2:-}" != --force ] && vpn_engine_in_use "$1"; then
        echo "the VPN is on with a profile that runs on $1: turn it off or use another profile first (mu300-vpn off), or: mu300-extra remove $1 --force" >&2
        return 1
    fi
    # the module out of every system first (its hooks are part of it): what an older image had comes back
    { extra_is_module "$1" || extra_own "$1"; } && module_hook_all "$1" unlink
    rm -rf "$EXTRA/$1" "$EXTRA/.$1.new" "$EXTRA/.$1.old" "$EXTRA/.$1.sha256"
    # the firmware the audio extra fetched (the copies it put into the systems went with hooks/unlink)
    [ "$1" != audio ] || rm -rf "${AUDIO_FW_CACHE%/*}"
    sync
    do_link
    [ "$1" != vpn ] || luci_menu_refresh
    echo "$1 removed"
}

do_list() {
    for x in $EXTRAS; do
        if [ -d "$EXTRA/$x/bin" ]; then st="installed ($(extra_release "$x"))"; else st="not installed"; fi
        [ "$x" != vpn ] || [ ! -d "$EXTRA/vpn/bin" ] || vpn_module_in "$EXTRA/vpn" || st="$st - the engines of an older release only, without mu300-vpn: mu300-extra install vpn"
        case $x in vpn-xray|vpn-singbox)
            [ ! -d "$EXTRA/$x/bin" ] && vpn_engine_have "$x" && st="carried by the vpn extra (module v1 or the bundle)" ;;
        esac
        if [ "$x" = audio ] && [ -d "$EXTRA/audio/bin" ] && [ "$(cat "$EXTRA/audio/kernel" 2>/dev/null)" != "$KERNEL_SERIES" ]; then
            st="$st - for kernel $(cat "$EXTRA/audio/kernel" 2>/dev/null), and this is $KERNEL_SERIES: mu300-extra install audio"
        elif [ "$x" = audio ] && [ -d "$EXTRA/audio/bin" ]; then
            st="$st, kernel $KERNEL_SERIES"
        fi
        printf '%-6s %s\n       %s\n' "$x" "$st" "$(extra_desc "$x")"
    done
}

do_status() {
    any=
    if [ -n "${1:-}" ]; then
        [ -d "$EXTRA/$1/bin" ] || { echo "$1 is not installed"; return 1; }
        _which=$1
    else
        _which=; for x in $(extra_installed); do extra_known "$x" && _which="$_which $x"; done
    fi
    for x in $_which; do
        any=1
        printf '%s\n  release   %s\n  size      %s\n' "$x" "$(extra_release "$x")" "$(du -sh "$EXTRA/$x" 2>/dev/null | cut -f1)"
        printf '  commands '
        for f in "$EXTRA/$x"/bin/*; do printf ' %s' "${f##*/}"; done
        printf '\n  location  %s\n' "$EXTRA/$x"
        [ -s "$EXTRA/$x/components" ] && sed 's/^/  contains  /' "$EXTRA/$x/components"
    done
    [ -n "$any" ] || echo "no extras installed (mu300-extra list)"
}

# tests/ source this file for its functions only
[ -z "${MU300_LIB:-}" ] || return 0

case ${1:-list} in
    list) do_list ;;
    status) [ -z "${2:-}" ] || extra_known "$2" || extra_own "$2" || die "there is no extra called '$2' (mu300-extra list)"
            do_status "${2:-}" ;;
    install) [ -n "${2:-}" ] || die "usage: mu300-extra install NAME [--from FILE|DIR]"; from=
             case ${3:-} in '') ;; --from) [ -n "${4:-}" ] || die "usage: mu300-extra install $2 --from FILE|DIR"; from=$4 ;;
                 *) die "usage: mu300-extra install NAME [--from FILE|DIR]" ;; esac
             # an extra of the user's own comes from a file only: without one the name is just unknown
             extra_own "$2" && [ -n "$from${MU300_EXTRA_FILE:-}" ] || known "$2"
             need_root install; need_disk; do_install "$2" "$from" ;;
    remove) [ -n "${2:-}" ] || die "usage: mu300-extra remove NAME"
            { extra_own "$2" && [ -d "$EXTRA/$2" ]; } || known "$2"; need_root remove; need_disk; do_remove "$2" "${3:-}" ;;
    link) need_root link; do_link ;;
    # gone: the VPN module carries its engines (an older mu300-vpn asks for it, then installs the extra)
    adopt) echo "nothing to adopt: the VPN module carries its own engines (mu300-extra install vpn)" >&2; exit 1 ;;
    -h|--help|help) sed -n '2,45s/^# \{0,1\}//p' "$0" ;;
    *) echo "usage: mu300-extra list|status|install NAME [--from FILE|DIR]|remove NAME|link" >&2; exit 2 ;;
esac

#!/bin/sh
# Optional parts that are not in the images, downloaded when you want them (Ubuntu and OpenWrt).
#   mu300-extra list              what there is, and what is installed
#   mu300-extra status            the installed extras: release, size, commands
#   mu300-extra install NAME      download it, check it against its release's SHA256SUMS, install it and put its
#                                 commands on the PATH (lang: from the release of this system; vpn, vpn-mihomo: the
#                                 latest release of the VPN module, github.com/dikeckaan/mu300-linux-vpn)
#   mu300-extra install vpn|vpn-mihomo --from FILE|DIR   offline: the module's tarball copied onto the device, or a
#                                 directory with the tarball and its SHA256SUMS (then it is verified)
#   mu300-extra remove NAME [--force]   (--force: the vpn extra even while the VPN is on)
#   mu300-extra link              put the system's commands and the extras' on the PATH, and link the VPN module
#                                 into this system (its hooks/link; run at every boot)
#   mu300-extra lang [list]       the languages of the lang extra, and which this system offers in LuCI
#   mu300-extra lang enable CODE...|all    offer them in LuCI (System > System > Language and Style)
#   mu300-extra lang disable CODE...|all   take them off that list again (the extra stays)
#
# Extras live on the Linux partition (/mnt/mu300-disk/extra/NAME), not in a system: Ubuntu and OpenWrt share one
# copy, and an update or reinstall of a system keeps it. mu300-update apply brings them up to date.
# There are three:
#   vpn         the VPN toolkit: mu300-vpn and its engines Xray-core, hev-socks5-tunnel and sing-box, the module of
#               github.com/dikeckaan/mu300-linux-vpn. Installing it links it into every installed system (the
#               images have no mu300-vpn); removing it takes it out of them again.
#   lang        LuCI's own catalogs in every language of the OpenWrt feed, and the MU300 panel's (OpenWrt only:
#               Ubuntu has no LuCI). install enables every language; which ones a system offers is its own
#               (/etc/mu300/languages, kept by updates; no file: all of them).
#   vpn-mihomo  mihomo (Clash.Meta), the engine of mu300-vpn's mihomo profiles, from the same module repository
#
# MU300_RELEASE=TAG takes another release, MU300_RELEASE_URL=URL another server with the same files and SHA256SUMS,
# MU300_VPN_URL=URL another place for the VPN module (a pinned tag: .../releases/download/v1.0.0), MU300_VPN_MODULE
# the same as --from, MU300_EXTRA_FILE=FILE a mu300-extra-NAME.tar.gz on this device (not checked: you chose it).
# The download, the checks and the installation are mu300-update's own (fetch_verified, module_get, extra_unpack).
BIN=${MU300_BIN:-/opt/mu300/bin}
_lib=${MU300_LIB:-}
MU300_LIB=1
. "$BIN/mu300-update"
MU300_LIB=$_lib
STAGE=$DISK/.mu300-extra
OPT=${MU300_OPT:-/opt/mu300}
SYSROOT=${MU300_SYSROOT:-}
# LuCI's catalogs, and the languages of the lang extra this system offers (no file: all of them)
I18N=${MU300_LUCI_I18N:-$SYSROOT/usr/lib/lua/luci/i18n}
LANGS_ON=$SYSROOT/etc/mu300/languages
NL='
'
TAB=$(printf '\t')

# where commands go: a directory on everybody's PATH, sudo's secure_path included (Ubuntu keeps usr/local across
# updates; OpenWrt's busybox PATH has no /usr/local)
link_dir() {
    if [ -n "${MU300_LINKDIR:-}" ]; then echo "$MU300_LINKDIR"
    elif [ -e "$SYSROOT/etc/openwrt_release" ]; then echo /usr/bin
    else echo /usr/local/bin; fi
}

# link: the system's commands (one list, the same the images are built with) and every installed extra's. A file
# or a link of somebody else's is never replaced; a link into an extra that is gone is removed.
do_link() { do_link_commands; do_link_modules; }
do_link_commands() {
    L=$(link_dir)
    mkdir -p "$L"
    if [ -r "$OPT/lib/path-commands" ]; then
        for c in $(cat "$OPT/lib/path-commands"); do
            [ -x "$OPT/bin/$c" ] || continue
            [ -e "$L/$c" ] || [ -L "$L/$c" ] || ln -s "$OPT/bin/$c" "$L/$c" 2>/dev/null || true
        done
    fi
    for x in $(extra_installed); do
        for f in "$EXTRA/$x"/bin/*; do
            [ -x "$f" ] || continue
            c=${f##*/}
            if [ -L "$L/$c" ]; then
                case $(readlink "$L/$c") in "$EXTRA"/*) ln -sfn "$f" "$L/$c" ;; esac
            elif [ ! -e "$L/$c" ]; then
                ln -s "$f" "$L/$c" 2>/dev/null || true
            fi
        done
    done
    for l in "$L"/*; do
        [ -L "$l" ] && [ ! -e "$l" ] || continue
        case $(readlink "$l") in "$EXTRA"/*) rm -f "$l" ;; esac
    done
    lang_link
}
# the VPN module into this system: a new image has none of it (the boot after an update or a reinstall)
do_link_modules() {
    for x in $(extra_installed); do
        extra_is_module "$x" || continue
        module_hook_fits "$x" link "$SYSROOT" "$(system_release)" || true
    done
    return 0
}

# ---- lang: LuCI's languages --------------------------------------------------------------------------------------
is_openwrt() { [ -e "$SYSROOT/etc/openwrt_release" ]; }
luci_uci() { uci -q ${SYSROOT:+-c "$SYSROOT/etc/config"} "$@"; }
# the languages of the installed lang extra: KEY<tab>NAME lines (checked when it was installed, and again here)
lang_lines() { LC_ALL=C grep -Ex -- "$LANG_LINE" "$EXTRA/lang/languages" 2>/dev/null; }
lang_keys() { lang_lines | cut -f1; }
lang_enabled() { [ ! -f "$LANGS_ON" ] || grep -qxF -- "$1" "$LANGS_ON"; }
# luci_languages: the keys of luci.languages
luci_languages() { luci_uci show luci.languages | sed -n "s/^luci\.languages\.\([a-z_]*\)=.*/\1/p"; }
# does LuCI have a catalog of language KEY (any component)?
lang_has_catalog() {
    _c=$(printf '%s' "$1" | tr _ -)
    for _f in "$I18N"/*."$_c".lmo; do [ -e "$_f" ] && return 0; done
    return 1
}
# lang_link: the catalogs of the enabled languages into LuCI's directory (links into the extra; a file or a link of
# somebody else's is never replaced), the links of disabled or vanished ones out, and luci.languages to match: an
# enabled language of the extra is registered, a registered language without any catalog left is not, and LuCI goes
# back to English when the language it was set to is gone. Nothing to do without LuCI.
lang_link() {
    is_openwrt && [ -d "$I18N" ] || return 0
    for _l in "$I18N"/*.lmo; do
        [ -L "$_l" ] || continue
        case $(readlink "$_l") in "$EXTRA"/*) ;; *) continue ;; esac
        _k=${_l%.lmo}; _k=$(printf '%s' "${_k##*.}" | tr - _)
        { [ -e "$_l" ] && lang_enabled "$_k"; } || rm -f "$_l"
    done
    for _f in "$EXTRA"/lang/i18n/*.lmo; do
        [ -f "$_f" ] || continue
        _n=${_f##*/}; _k=${_n%.lmo}; _k=$(printf '%s' "${_k##*.}" | tr - _)
        lang_enabled "$_k" || continue
        if [ -L "$I18N/$_n" ]; then
            case $(readlink "$I18N/$_n") in "$EXTRA"/*) ln -sfn "$_f" "$I18N/$_n" ;; esac
        elif [ ! -e "$I18N/$_n" ]; then
            ln -s "$_f" "$I18N/$_n" 2>/dev/null || true
        fi
    done
    _ch=
    luci_uci get luci.languages >/dev/null || { luci_uci set luci.languages=internal && _ch=1; }
    while IFS="$TAB" read -r _k _name; do
        [ -n "$_k" ] && lang_enabled "$_k" && lang_has_catalog "$_k" || continue
        [ "$(luci_uci get "luci.languages.$_k")" = "$_name" ] && continue
        luci_uci set "luci.languages.$_k=$_name" && _ch=1
    done <<LANGS
$(lang_lines)
LANGS
    for _k in $(luci_languages); do
        lang_has_catalog "$_k" || { luci_uci delete "luci.languages.$_k" && _ch=1; }
    done
    _cur=$(luci_uci get luci.main.lang)
    case $_cur in
        ''|auto|en) ;;
        *) luci_uci get "luci.languages.$_cur" >/dev/null || { luci_uci set luci.main.lang=en && _ch=1; } ;;
    esac
    [ -z "$_ch" ] || luci_uci commit luci
    return 0
}

# lang list | enable CODE...|all | disable CODE...|all
do_lang() {
    [ -d "$EXTRA/lang/i18n" ] || die "the lang extra is not installed (mu300-extra install lang)"
    case ${1:-list} in
        list)
            lang_lines | while IFS="$TAB" read -r k name; do
                if lang_enabled "$k"; then st=enabled; else st=disabled; fi
                printf '%s\t%s\t%s\n' "$k" "$st" "$name"
            done ;;
        enable|disable)
            op=$1; shift
            [ $# -gt 0 ] || die "usage: mu300-extra lang $op CODE...|all"
            need_root lang
            is_openwrt || die "LuCI's languages are for OpenWrt; this system has no LuCI"
            all=$(lang_keys)
            if [ "$1" = all ]; then
                [ $# = 1 ] || die "all goes alone"
                mkdir -p "${LANGS_ON%/*}"
                if [ "$op" = enable ]; then rm -f "$LANGS_ON"; else : > "$LANGS_ON"; fi
            else
                for k in "$@"; do
                    printf '%s\n' "$all" | grep -qx -- "$k" || die "no language '$k' in the lang extra (mu300-extra lang list)"
                done
                on=$(for k in $all; do lang_enabled "$k" && echo "$k"; done)
                for k in "$@"; do
                    if [ "$op" = enable ]; then on="$on$NL$k"; else on=$(printf '%s\n' "$on" | grep -vx -- "$k"); fi
                done
                mkdir -p "${LANGS_ON%/*}"
                printf '%s\n' "$on" | grep . | sort -u > "$LANGS_ON.new"
                mv "$LANGS_ON.new" "$LANGS_ON"
            fi
            lang_link
            echo "LuCI offers: en $(luci_languages | tr '\n' ' ')" ;;
        *) die "usage: mu300-extra lang [list | enable CODE...|all | disable CODE...|all]" ;;
    esac
}

need_root() { [ "$(id -u)" = 0 ] || die "run as root (sudo mu300-extra $*)"; }
need_disk() { [ -d "$DISK/ubuntu" ] || [ -d "$DISK/openwrt" ] || [ -d "$DISK/openwrt-luci" ] || die "the Linux partition is not mounted at $DISK"; }
known() { extra_known "$1" || die "there is no extra called '$1' (mu300-extra list)"; }

# the release whose extra goes with this system: MU300_RELEASE, the system's own, or the newest
system_release() {
    v=$(cat "$SYSROOT/etc/mu300/image-version" 2>/dev/null)
    case $v in v[0-9]*) echo "$v" ;; esac
}

# install vpn|vpn-mihomo [FROM]: the module, from FROM (a file, or a directory with SHA256SUMS) or its latest release
do_install_module() {
    name=$1
    from=${2:-${MU300_VPN_MODULE:-}}
    [ -n "$from" ] || say "downloading $(module_asset "$name") from $VPN_URL"
    module_get "$name" "$STAGE" "$from"; r=$?
    case $r in
        0) module_install "$name" "$MODULE_FILE" "$MODULE_SHA" "$(system_release)" || { rm -rf "$STAGE"; die "$name was not installed"; } ;;
        3) echo "$name $(extra_release "$name") is the latest release already" ;;
        1) rm -rf "$STAGE"; die "$name was not installed: the VPN module could not be downloaded (is the device online? Offline: mu300-extra install $name --from FILE)" ;;
        *) rm -rf "$STAGE"; die "$name was not installed" ;;
    esac
    rm -rf "$STAGE"
    do_link_commands
    module_hook_all "$name" link || echo "$name: a system it could not be linked into gets it at its next boot (mu300-extra link)" >&2
    printf '%s %s installed in %s\n' "$name" "$(extra_release "$name")" "$EXTRA/$name"
}

do_install() {
    name=$1
    [ "$name" != lang ] || is_openwrt || die "the lang extra is LuCI's languages, for OpenWrt only: install it from an OpenWrt system"
    if extra_is_module "$name" && [ -z "${MU300_EXTRA_FILE:-}" ]; then
        do_install_module "$name" "${2:-}"
        return
    fi
    [ -z "${2:-}" ] || die "--from is for the VPN module (vpn, vpn-mihomo); for $name: MU300_EXTRA_FILE=FILE"
    if [ -n "${MU300_EXTRA_FILE:-}" ]; then
        [ -s "$MU300_EXTRA_FILE" ] || die "$MU300_EXTRA_FILE not found"
        extra_unpack "$name" "$MU300_EXTRA_FILE" "$(system_release)" || die "$name was not installed"
        rm -f "$EXTRA/.$name.sha256"
    else
        tag=${MU300_RELEASE:-$(system_release)}
        [ -n "$tag" ] || tag=$(latest_release)
        [ -n "$tag" ] || die "could not reach GitHub (is the device online?)"
        asset=$(extra_asset "$name")
        say "downloading $asset of $tag"
        fetch_verified "$tag" "$asset"; r=$?
        # a system from before extras: its release has none, the newest one has
        if [ "$r" = 2 ] && [ -z "${MU300_RELEASE:-}" ]; then
            newest=$(latest_release)
            if [ -n "$newest" ] && [ "$newest" != "$tag" ]; then
                tag=$newest
                say "downloading $asset of $tag"
                fetch_verified "$tag" "$asset"; r=$?
            fi
        fi
        [ "$r" = 0 ] || { rm -rf "$STAGE"; die "$name was not installed (no verified $asset of $tag)"; }
        extra_unpack "$name" "$STAGE/$asset" || { rm -rf "$STAGE"; die "$name was not installed"; }
        rm -rf "$STAGE"
    fi
    # a fresh install of the languages offers all of them
    [ "$name" != lang ] || rm -f "$LANGS_ON"
    if extra_is_module "$name"; then
        do_link_commands
        module_hook_all "$name" link || true
    else
        do_link
    fi
    printf '%s %s installed in %s\n' "$name" "$(extra_release "$name")" "$EXTRA/$name"
}

do_remove() {
    [ -d "$EXTRA/$1" ] || { echo "$1 is not installed"; return 0; }
    # a VPN that is on loses its tunnel, and (kill switch up) the device its connection, until they are back
    if [ "$1" = vpn ] && [ "${2:-}" != --force ] && extra_vpn_wanted "$SYSROOT"; then
        echo "the VPN is on (ENABLE=1 in /etc/mu300/vpn.conf): turn it off first (mu300-toolkit, or ENABLE=0 and mu300-vpn off), or: mu300-extra remove vpn --force" >&2
        return 1
    fi
    # the module out of every system first (its hooks are part of it): what an older image had comes back
    extra_is_module "$1" && module_hook_all "$1" unlink
    rm -rf "$EXTRA/$1" "$EXTRA/.$1.new" "$EXTRA/.$1.old" "$EXTRA/.$1.sha256"
    [ "$1" != lang ] || rm -f "$LANGS_ON"
    sync
    do_link
    echo "$1 removed"
}

do_list() {
    for x in $EXTRAS; do
        if [ -d "$EXTRA/$x/bin" ] || [ -d "$EXTRA/$x/i18n" ]; then st="installed ($(extra_release "$x"))"; else st="not installed"; fi
        [ "$x" != vpn ] || [ ! -d "$EXTRA/vpn/bin" ] || vpn_module_in "$EXTRA/vpn" || st="$st - the engines of an older release only, without mu300-vpn: mu300-extra install vpn"
        [ "$x" != lang ] || is_openwrt || st="$st - for OpenWrt only: Ubuntu has no LuCI"
        printf '%-6s %s\n       %s\n' "$x" "$st" "$(extra_desc "$x")"
    done
}

do_status() {
    any=
    for x in $(extra_installed); do
        any=1
        printf '%s\n  release   %s\n  size      %s\n' "$x" "$(extra_release "$x")" "$(du -sh "$EXTRA/$x" 2>/dev/null | cut -f1)"
        if [ "$x" = lang ]; then
            if is_openwrt; then on=$(for k in $(lang_keys); do lang_enabled "$k" && printf '%s ' "$k"; done); else on="none (no LuCI)"; fi
            printf '  languages %s, offered here: %s' "$(lang_keys | wc -l | tr -d ' ')" "${on:-none}"
        else
            printf '  commands '
            for f in "$EXTRA/$x"/bin/*; do printf ' %s' "${f##*/}"; done
        fi
        printf '\n  location  %s\n' "$EXTRA/$x"
        [ -s "$EXTRA/$x/components" ] && sed 's/^/  contains  /' "$EXTRA/$x/components"
    done
    [ -n "$any" ] || echo "no extras installed (mu300-extra list)"
}

# tests/ source this file for its functions only
[ -z "${MU300_LIB:-}" ] || return 0

case ${1:-list} in
    list) do_list ;;
    status) do_status ;;
    install) [ -n "${2:-}" ] || die "usage: mu300-extra install NAME [--from FILE|DIR]"; known "$2"; from=
             case ${3:-} in '') ;; --from) [ -n "${4:-}" ] || die "usage: mu300-extra install $2 --from FILE|DIR"; from=$4 ;;
                 *) die "usage: mu300-extra install NAME [--from FILE|DIR]" ;; esac
             need_root install; need_disk; do_install "$2" "$from" ;;
    remove) [ -n "${2:-}" ] || die "usage: mu300-extra remove NAME"; known "$2"; need_root remove; need_disk; do_remove "$2" "${3:-}" ;;
    link) need_root link; do_link ;;
    # gone: the VPN module carries its engines (an older mu300-vpn asks for it, then installs the extra)
    adopt) echo "nothing to adopt: the VPN module carries its own engines (mu300-extra install vpn)" >&2; exit 1 ;;
    lang) shift; do_lang "$@" ;;
    -h|--help|help) sed -n '2,31s/^# \{0,1\}//p' "$0" ;;
    *) echo "usage: mu300-extra list|status|install NAME [--from FILE|DIR]|remove NAME|link|lang ..." >&2; exit 2 ;;
esac

#!/bin/sh
# Vendor drivers Android loads that the initramfs does not: thermal throttling, status LEDs, SAR power
# backoff, SIM tray detection, vibrator, DDR/CP DVFS and the Mali GPU (/dev/mali0). Loaded one by one; a failure is logged, not fatal.
# On the mainline kernel the modem stack is not in the boot image at all: the SIPA accelerator attaches to the
# USB gadget's usb0 as it is created, and a gadget created while those modules are already loaded transmits
# nothing the host ever sees. So they are loaded here, once userspace is up and the gadget is long since bound.
M=/lib/modules/$(uname -r)
if [ -f "$M/sipc-core.ko" ] && ! [ -e /dev/modem ]; then
    for m in sprd_systimer sprd_time_sync sprd_time_sync_cp trusty trusty-pm trusty-log trusty-irq trusty-ipc \
             trusty-virtio sprd_shm unisoc-mailbox sprd-sipc-virt-bus sprd_power_manager sipc-core spipe spool \
             sipx seth slog_bridge sbuf_bridge sblock_bridge sprd_modem_loader sipa-sys sipa-core sipa_eth \
             sprdbt_tty; do
        for f in "$M/$m.ko" "$M/$(echo "$m" | tr '_' '-').ko"; do
            [ -f "$f" ] || continue
            insmod "$f" 2>/dev/null && echo "loaded $m" || echo "FAILED $m"
            break
        done
    done
fi

for m in sprd_soc_thm thermal-generic-adc sprd_cpu_cooling leds-sc27xx-bltc zte_sar zte_card_holder_det sc27xx-vibra sprd_cp_dvfs sprd_ddr_dvfs sprd_gpu_cooling mali_kbase; do
    if modprobe "$m" 2>/tmp/mu300-modprobe.err; then
        echo "loaded $m"
    else
        echo "FAILED $m: $(cat /tmp/mu300-modprobe.err)"
    fi
done
true

#!/bin/sh
# The modules the boot does not load: the modem stack, the PM co-processor's watchdog, the stock thermal zone, the
# cluster power-down's wake sources, the virtual sound card. Loaded one by one from the kernel bundle's flat module
# directory; a failure is logged, not fatal.
# The modem stack is not in the boot image at all: the SIPA accelerator attaches to the USB gadget's usb0 as it is
# created, and a gadget created while those modules are already loaded transmits nothing the host ever sees. So they
# are loaded here, once userspace is up and the gadget is long since bound.
# sipa-dele is deliberately not in that list: it has to come after the modem, not with it (see below).
M=/lib/modules/$(uname -r)
if [ -f "$M/sipc-core.ko" ] && ! [ -e /dev/modem ]; then
    for m in sprd_systimer sprd_time_sync sprd_time_sync_cp trusty trusty-pm trusty-log trusty-irq trusty-ipc \
             trusty-virtio sprd_shm unisoc-mailbox sprd-sipc-virt-bus sprd_power_manager sipc-core spipe spool \
             sipx seth slog_bridge sbuf_bridge sblock_bridge sprd_modem_loader sipa-sys sipa-core sipa_eth \
             sprdbt_tty; do
        for f in "$M/$m.ko" "$M/$(echo "$m" | tr '_' '-').ko"; do
            [ -f "$f" ] || continue
            insmod "$f" 2>/dev/null && echo "loaded $m" || echo "FAILED $m"
            break
        done
    done
fi

# The IPA delegate (sipa-dele) is not loaded here, nor started from here. It has to come after the modem is attached
# to the packet domain and before the PDP context: loaded in the background from here it raced the dial, and inserted
# after AT+CGACT its probe hits a reproducible CFI panic. mobile-data loads it itself, through sipa-dele-start,
# between the registration and AT+CGACT. See those two scripts.

# The PM co-processor keeps its own watchdog, and it power-cuts the device a few minutes after boot unless this
# driver tells pm_sys to stop it.
if [ -f "$M/sprd_pmic_wdt.ko" ] && ! grep -q '^sprd_pmic_wdt ' /proc/modules; then
    insmod "$M/sprd_pmic_wdt.ko" 2>/dev/null && echo "loaded sprd_pmic_wdt" || echo "FAILED sprd_pmic_wdt"
fi

# mu300_thermal: the stock virtual thermal zone, soc-thmzone, with the device tree's trips and cpufreq cooling maps,
# so the kernel throttles the clusters at 85 C and mu300-sysd's thermal guard hands frequency control over; without
# it the guard is in charge. ums9620_lpintc: the interrupts the kernel enabled become wake sources of the CPU
# clusters' power-down, which TF-A left at its own short list (USB, IPA and the Wi-Fi's PCIe were not on it); without
# it an interrupt waits for something else to wake the cluster. modprobe needs depmod's index, so insmod by path is
# the fallback.
for m in mu300_thermal ums9620_lpintc; do
    grep -q "^$m " /proc/modules && continue
    [ -f "$M/$m.ko" ] || continue
    if modprobe "$m" 2>/dev/null || insmod "$M/$m.ko" 2>/dev/null; then echo "loaded $m"; else echo "FAILED $m"; fi
done

# The virtual sound card: the board has no speaker path, so software that wants an ALSA device (a program that
# bridges a call, for one) gets a playback/capture pair wired back to back instead - write to hw:0,0 and read it
# back on hw:0,1. Harmless when nothing opens it.
if ! grep -q '^snd_aloop ' /proc/modules; then
    if modprobe snd-aloop 2>/dev/null; then
        echo "loaded snd-aloop"
    elif [ -f "$M/snd-aloop.ko" ]; then
        insmod "$M/snd-aloop.ko" 2>/dev/null && echo "loaded snd-aloop" || echo "FAILED snd-aloop"
    fi
fi

true

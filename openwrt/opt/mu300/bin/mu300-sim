#!/bin/sh
# Select one SIM for the whole boot. Reopening SIPC channels is not a hot switch.
# The preference is network.wan.sim_slot.
# Shared boot preferences are saved here; live modem operations dispatch only to the gated U30 backend.
set -eu
umask 077
root=${MU300_SIM_ROOT:-}
state=$root/run/mu300/sim-slot
device_cmd=${MU300_DEVICE_CMD:-/opt/mu300/bin/mu300-device}
backend=${MU300_SIM_U30_BACKEND:-/opt/mu300/bin/mu300-sim-u30}
lib=${MU300_SIM_CONFIG_LIB:-/opt/mu300/lib/sim-config.sh}
# The short way. Every AT client asks "active" before every command (mu300-at, mobile-data, the panel's collectors),
# and on nearly every device the answer is the pinned 0: one file read, as it was before the U30 backend existed
# (measured on a U30 Air: 2.8 ms a call; with the library and the device's name read first, 6.7 ms).
if [ "${1:-}" = active ] && [ "$#" = 1 ] && [ -f "$state" ] && [ "$(cat "$state" 2>/dev/null)" = 0 ]; then
    echo 0
    exit 0
fi
. "$lib"
device_name() {
    [ -x "$device_cmd" ] || return 0
    "$device_cmd" 2>/dev/null || true
}
SIM_CONFIG_U30=0
if [ "$(device_name)" = u30air ]; then SIM_CONFIG_U30=1; fi
export SIM_CONFIG_U30
u30_supported() { [ "$SIM_CONFIG_U30" = 1 ]; }

ensure_f50() {
    local device
    device=$(device_name)
    [ "$device" != f50 ] || return 0
    u30_supported || {
        echo "mu300-sim: SIM selection is supported on the F50 and the U30 Air only (detected $device)" >&2
        return 1
    }
}
slot1_supported() {
    [ "$(device_name)" != f50 ] || return 0
    u30_supported
}
ensure_slot_supported() {
    [ "$1" != 1 ] || ensure_f50
}
valid() { case "$1" in 0|1) return 0 ;; *) echo 'SIM slot must be 0 (external) or 1 (internal)' >&2; return 1 ;; esac; }
# `default` takes the card numbers the panel shows (1 external, 2 internal), not `select`'s slot numbers: its refusal
# names its own numbering
valid_default() { case "$1" in 1|2) return 0 ;; *) echo 'SIM card must be 1 (external) or 2 (internal)' >&2; return 1 ;; esac; }
configured() { sim_cfg_default; }

active() {
    local slot tmp
    if [ ! -e "$state" ]; then
        # A value that is not 0 or 1 (hand-edited, a half-written config) pins the external card: every AT owner
        # asks this at start, and failing here would leave the device without AT, data or SMS for the whole boot.
        slot=$(configured 2>/dev/null) || {
            echo 'mu300-sim: the configured SIM slot is not 0 or 1; using external slot 0 for this boot' >&2
            slot=0
        }
        mkdir -p "${state%/*}"
        # Publish once, atomically. Concurrent daemon starts keep the same boot slot.
        tmp=$(mktemp "${state}.XXXXXX") || return 1
        printf '%s\n' "$slot" > "$tmp"
        ln "$tmp" "$state" 2>/dev/null || { [ -f "$state" ] || { rm -f "$tmp"; return 1; }; }
        rm -f "$tmp"
    fi
    slot=$(cat "$state")
    valid "$slot" || return 1
    if [ "$slot" = 1 ] && ! slot1_supported; then
        echo 'mu300-sim: ignoring unsupported slot 1; using external slot 0' >&2
        slot=0
    fi
    printf '%s\n' "$slot"
}
case ${1:-status} in
    migrate)
        [ "$#" = 1 ] || exit 2
        u30_supported || exit 1
        sim_cfg_migrate
        exit $?
        ;;
    active) active ;;
    configured) configured ;;
    status)
        case ${2:-} in ''|--json) ;; *) exit 2;; esac
        [ "$#" -le 2 ] || exit 2
        if u30_supported && [ "${2:-}" = --json ]; then exec "$backend" status --json; fi
        old=$(active) || exit 1
        next=$(configured) || exit 1
        supported=0
        slot1_supported && supported=1
        if [ "${2:-}" = --json ]; then
            printf '{"version":1,"ok":1,"active":%s,"default":%s,"slot1_supported":%s,"hot":0,"available":false,"busy":false,"phase":"idle","result":"reboot_required","error":null,"capabilities":{"boot_selection":%s,"live_switch":false},"radio_ready":null,"registered":null,"wan_up":null}\n' "$((old + 1))" "$((next + 1))" "$supported" "$([ "$supported" = 1 ] && echo true || echo false)"
        else
            printf 'active slot: %s\nnext boot slot: %s\n' "$old" "$next"
        fi
        ;;
    select|default)
        # "|| exit 2": under set -e a failing "valid" would end the script with its own status 1
        if [ "$1" = default ]; then
            case ${2:-} in 1) next=0 ;; 2) next=1 ;; *) valid_default invalid || exit 2 ;; esac
        else
            case ${2:-} in external|0) next=0 ;; internal|1) next=1 ;; *) valid invalid || exit 2 ;; esac
        fi
        ensure_slot_supported "$next" || exit 1
        # Pin the current slot before changing the next-boot setting.
        old=$(active) || exit 1
        if u30_supported; then
            command -v flock >/dev/null 2>&1 || exit 1
            mkdir -p "$root/run/mu300"
            exec 9>"$root/run/mu300/sim-control.lock"
            flock -n 9 || { echo 'mu300-sim: SIM control is busy' >&2; exit 1; }
        fi
        sim_cfg_save_default "$next" || exit 1
        if u30_supported; then
            rm -f "$root/etc/mu300-sim-fallback"
            MU300_SIM_LOCKED=1 "$backend" status --json
            exit $?
        fi
        echo "SIM slot $next saved. Active slot remains $old until reboot."
        ;;
    hot|switch)
        [ "$#" = 2 ] || exit 2
        if u30_supported; then exec "$backend" "$@"; fi
        echo 'mu300-sim: live SIM switching is not supported on F50; select a slot and reboot' >&2
        exit 1
        ;;
    *) echo 'usage: mu300-sim status [--json]|active|configured|select external|internal|0|1, default 1|2 (default: 1 external, 2 internal; U30 Air also: hot 0|1, switch 1|2)' >&2; exit 2 ;;
esac

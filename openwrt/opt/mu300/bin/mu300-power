#!/bin/sh
# What the MU300 does with its battery: profiles, idle radios, the charging boot.
#   mu300-power status                  state, profile and why, battery, charger, idle timer
#   mu300-power profile [NAME|auto]     force a profile (plugged|battery|saver), or back to automatic
#   mu300-power set PROFILE.KNOB VALUE  knobs: WIFI_IDLE (minutes, 0 never), RADIO_IDLE keep|lte|off,
#                                       LEDS_IDLE on|off, CPU full|eco; also set SAVER_BELOW N, CHARGE_TO 100|80
#   mu300-power wake                    leave idle (the keys call it); restarts the idle timer
#   mu300-power idle                    enter idle now
#   mu300-power log [SECONDS] [FILE]    append time,V,mA,W,%,temp,state,profile every SECONDS (5) to FILE
#                                       (/var/log/mu300-power.csv)
#   mu300-power daemon                  the state machine (mu300-power.service, /etc/init.d/mu300-power)
# Design: docs/superpowers/specs/2026-10-06-power-profiles-design.md. Configuration: /etc/mu300/power.conf,
# KEY=VALUE, kept across updates with the rest of etc/mu300; a missing key is its default below.
set -u
export PATH="$PATH:/opt/mu300/bin:/opt/mu300/busybox-bin:/usr/sbin:/sbin"
R=${MU300_SYSROOT:-}
RUN=${MU300_RUN:-/run}/mu300
CONF=${MU300_POWER_CONF:-/etc/mu300/power.conf}
ST=$RUN/power
PROFILES="plugged battery saver"
KNOBS="WIFI_IDLE RADIO_IDLE LEDS_IDLE CPU"

say() { echo "mu300-power: $*" >&2; logger -t mu300-power -- "$*" 2>/dev/null || true; }

# --- configuration
default() {  # default KEY: the built-in value of a top-level key or PROFILE_KNOB
    case $1 in
        PROFILE) echo auto ;; SAVER_BELOW) echo 20 ;; CHARGE_TO) echo 100 ;;
        plugged_WIFI_IDLE) echo 0 ;;  plugged_RADIO_IDLE) echo keep ;; plugged_LEDS_IDLE) echo on ;;  plugged_CPU) echo full ;;
        battery_WIFI_IDLE) echo 10 ;; battery_RADIO_IDLE) echo off ;;  battery_LEDS_IDLE) echo off ;; battery_CPU) echo full ;;
        saver_WIFI_IDLE) echo 5 ;;    saver_RADIO_IDLE) echo off ;;    saver_LEDS_IDLE) echo off ;;   saver_CPU) echo eco ;;
        *) return 1 ;;
    esac
}
valid() {  # valid KEY VALUE
    case $1 in
        PROFILE) case $2 in auto|plugged|battery|saver) return 0 ;; esac ;;
        SAVER_BELOW) case $2 in [0-9]|[1-9][0-9]|100) return 0 ;; esac ;;
        CHARGE_TO) case $2 in 100|80) return 0 ;; esac ;;
        *_WIFI_IDLE) case $2 in ''|*[!0-9]*) ;; *) [ ${#2} -le 4 ] && return 0 ;; esac ;;
        *_RADIO_IDLE) case $2 in keep|lte|off) return 0 ;; esac ;;
        *_LEDS_IDLE) case $2 in on|off) return 0 ;; esac ;;
        *_CPU) case $2 in full|eco) return 0 ;; esac ;;
    esac
    return 1
}
conf_raw() { sed -n "s/^$1=\(.*\)\$/\1/p" "$CONF" 2>/dev/null | tail -n1; }
conf_get() {  # conf_get KEY: the file's value when valid, else the default; an invalid one is noted for status
    _v=$(conf_raw "$1")
    if [ -n "$_v" ] && valid "$1" "$_v"; then echo "$_v"; return 0; fi
    [ -z "$_v" ] || { mkdir -p "$ST" 2>/dev/null; grep -qx "$1" "$ST/ignored" 2>/dev/null || echo "$1" >> "$ST/ignored" 2>/dev/null; }
    default "$1"
}
knob() { conf_get "$1_$2"; }
conf_set() {  # conf_set KEY VALUE: validate, then replace the line or append it
    default "$1" >/dev/null || { echo "mu300-power: no such key: $1" >&2; return 2; }
    valid "$1" "$2" || { echo "mu300-power: bad value for $1: $2" >&2; return 2; }
    mkdir -p "${CONF%/*}" 2>/dev/null
    [ -f "$CONF" ] || : > "$CONF"
    if grep -q "^$1=" "$CONF"; then
        sed "s/^$1=.*\$/$1=$2/" "$CONF" > "$CONF.tmp" && mv "$CONF.tmp" "$CONF"
    else
        [ -z "$(tail -c1 "$CONF")" ] || echo >> "$CONF"   # no trailing newline: add one first
        echo "$1=$2" >> "$CONF"
    fi
}

# --- the device
psy_all() {  # psy_all TYPE...: every power_supply directory whose type is one of them
    for _d in "$R"/sys/class/power_supply/*; do
        [ -f "$_d/type" ] || continue
        _t=$(cat "$_d/type" 2>/dev/null)
        for _w in "$@"; do [ "$_t" = "$_w" ] && { echo "$_d"; break; }; done
    done
}
psy_of_type() {  # the first one, or return 1
    _f=$(psy_all "$@" | sed -n 1p)
    [ -n "$_f" ] && echo "$_f"
}
battery_dir() {  # the first Battery that is present (present=1 or no present file)
    for _d in $(psy_all Battery); do
        [ ! -f "$_d/present" ] || [ "$(cat "$_d/present" 2>/dev/null)" = 1 ] && { echo "$_d"; return 0; }
    done
    return 1
}
rd() { cat "$1" 2>/dev/null; }
num() { case ${1#-} in ""|*[!0-9]*) echo 0 ;; *) echo "$1" ;; esac; }   # a number for arithmetic: empty or junk is 0
capacity() { _d=$(battery_dir) && rd "$_d/capacity"; }
battery_temp() { _d=$(battery_dir) && rd "$_d/temp"; }
charger_dir() { psy_of_type USB Mains; }
plugged() {
    _any=
    for _d in $(psy_all USB Mains); do
        _any=1
        [ "$(rd "$_d/online")" = 1 ] && return 0
    done
    [ -z "$_any" ] || return 1
    for _s in "$R"/sys/class/extcon/*/state; do grep -qx 'USB=1' "$_s" 2>/dev/null && return 0; done
    battery_dir >/dev/null || return 0   # no battery at all (the F50): it runs on the cable
    return 1
}
pick_profile() {  # prints NAME; also sets PICKED and WHY (not visible to a caller that runs it in $( ))
    _p=$(conf_get PROFILE)
    if [ "$_p" != auto ]; then PICKED=$_p WHY=forced; echo "$PICKED"; return 0; fi
    if plugged; then PICKED=plugged WHY=auto; echo "$PICKED"; return 0; fi
    _below=$(conf_get SAVER_BELOW); _cap=$(capacity)
    case $_cap in ''|*[!0-9]*) _cap= ;; esac
    if [ "$_below" != 0 ] && [ -n "$_cap" ] && [ "$_cap" -lt "$_below" ]; then
        PICKED=saver WHY="auto, battery under $_below %"
    else
        PICKED=battery WHY=auto
    fi
    echo "$PICKED"
}

# --- commands
cmd_status() {
    rm -f "$ST/ignored" 2>/dev/null
    pick_profile >/dev/null   # not in $( ): WHY would be lost in a subshell
    echo "profile: $PICKED ($WHY)"
    echo "state: $(rd "$ST/state" || echo active)"
    [ -s "$ST/reason" ] && echo "last change: $(rd "$ST/reason")"
    if _b=$(battery_dir); then
        echo "battery: $(rd "$_b/capacity") % $(rd "$_b/status" | tr 'A-Z' 'a-z'), $(( $(num "$(rd "$_b/voltage_now")") / 1000 )) mV, $(( $(num "$(rd "$_b/current_now")") / 1000 )) mA, $(( $(num "$(rd "$_b/temp")") / 10 )) C"
    else
        echo "battery: none"
    fi
    if _c=$(charger_dir); then echo "charger: $(rd "$_c/status" | tr 'A-Z' 'a-z') online=$(rd "$_c/online") usb_type=$(rd "$_c/usb_type" | sed -n 's/.*\[\([A-Za-z_]*\)\].*/\1/p')"; fi
    echo "supply: $(plugged && echo plugged || echo battery)"
    echo "SAVER_BELOW=$(conf_get SAVER_BELOW) CHARGE_TO=$(conf_get CHARGE_TO)"
    for _p in $PROFILES; do
        echo "$_p: WIFI_IDLE=$(knob "$_p" WIFI_IDLE) RADIO_IDLE=$(knob "$_p" RADIO_IDLE) LEDS_IDLE=$(knob "$_p" LEDS_IDLE) CPU=$(knob "$_p" CPU)"
    done
    [ -s "$ST/idle-since" ] && echo "idle timer: last client $(( $(num "$(uptime_s)") - $(num "$(rd "$ST/idle-since")") )) s ago"
    [ -s "$ST/ignored" ] && echo "ignored in power.conf: $(LC_ALL=C sort -u "$ST/ignored" | tr '\n' ' ' | sed 's/ $//')"
    return 0
}
cmd_set() {
    [ $# -eq 2 ] || { echo "usage: mu300-power set PROFILE.KNOB VALUE | set KEY VALUE" >&2; return 2; }
    _k=$1
    case $_k in *.*) _k="${_k%%.*}_${_k#*.}" ;; esac
    conf_set "$_k" "$2"
}
cmd_profile() {
    [ $# -eq 0 ] && { pick_profile; return 0; }
    conf_set PROFILE "$1"
}
uptime_s() { cut -d. -f1 "$R/proc/uptime" 2>/dev/null || date +%s; }

# --- inputs
is_openwrt() { [ -f "$R/etc/openwrt_release" ]; }
stations() { _n=$(iw dev wlan0 station dump 2>/dev/null | grep -c '^Station'); num "$_n"; }   # a failed dump is 0 stations
usb_host() { for _s in "$R"/sys/class/udc/*/state; do [ "$(rd "$_s")" = configured ] && return 0; done; return 1; }
activity() {  # anyone there? a Wi-Fi station, a computer on USB, or a key press (the wake flag)
    [ "$(stations)" -gt 0 ] && return 0
    usb_host && return 0
    [ -e "$ST/wake" ]
}

# --- actions (idempotent; a failure is logged and the state still changes - the next loop retries)
# A failed action is logged and noted in $ST/retry ("hotspot on", "modem resume"...); retry_run repeats it.
retry_drop() { [ -f "$ST/retry" ] && { grep -v "^$1 " "$ST/retry" > "$ST/retry.tmp"; mv "$ST/retry.tmp" "$ST/retry"; }; return 0; }
retry_note() { retry_drop "$1"; say "$1 $2 failed, will retry"; echo "$1 $2" >> "$ST/retry"; }
hotspot() {  # hotspot on|off
    if is_openwrt; then
        if [ "$1" = off ]; then wifi down </dev/null >/dev/null 2>&1; else wifi up </dev/null >/dev/null 2>&1; fi
    else
        if [ "$1" = off ]; then systemctl stop mu300-hotspot </dev/null; else systemctl start mu300-hotspot </dev/null; fi 2>/dev/null
    fi
    _rc=$?
    if [ $_rc -ne 0 ]; then retry_note hotspot "$1"; return 0; fi
    retry_drop hotspot
    if is_openwrt; then
        if [ "$1" = off ]; then mu300-led wifi off 2>/dev/null || true
        else ( mu300-led wifi sync 120 ) </dev/null >/dev/null 2>&1 & fi
    fi
    return 0
}
leds_idle() { mu300-led idle "$1" 2>/dev/null || true; }
modem_idle() {  # modem_idle keep|lte|off | modem_idle resume
    case $1 in
        keep) ;;
        lte|off) if mobile-data suspend "$1" </dev/null 2>/dev/null; then retry_drop modem; else retry_note modem "$1"; fi ;;
        resume) if mobile-data resume </dev/null 2>/dev/null; then retry_drop modem; else retry_note modem resume; fi ;;
    esac
    return 0
}
retry_run() {  # repeat what failed, if the state still wants it; the actions note themselves again if they fail
    [ -s "$ST/retry" ] || return 0
    _st=$(rd "$ST/state"); mv "$ST/retry" "$ST/retry.run"
    while read -r _k _v; do
        case "$_st:$_k $_v" in
            idle:hotspot\ off|charging-boot:hotspot\ off) hotspot off </dev/null ;;
            idle:modem\ lte|idle:modem\ off|charging-boot:modem\ off) modem_idle "$_v" </dev/null ;;
            *:hotspot\ on) [ "$_st" = idle ] || [ "$_st" = charging-boot ] || hotspot on </dev/null ;;
            *:modem\ resume) [ "$_st" = idle ] || [ "$_st" = charging-boot ] || modem_idle resume </dev/null ;;
        esac
    done < "$ST/retry.run"
    rm -f "$ST/retry.run"
    return 0
}
CPU=$R/sys/devices/system/cpu
cpu() {  # cpu eco|full
    if [ "$1" = eco ]; then
        if [ ! -e "$ST/cpu-max4" ]; then   # the marker says eco was applied, even when the limit could not be read
            _m=$(rd "$CPU/cpufreq/policy4/scaling_max_freq"); [ -n "$_m" ] || _m=$(rd "$CPU/cpufreq/policy4/cpuinfo_max_freq")
            echo "$_m" > "$ST/cpu-max4"
        fi
        echo 1500000 > "$CPU/cpufreq/policy4/scaling_max_freq" 2>/dev/null
        echo 0 > "$CPU/cpu7/online" 2>/dev/null
    else
        if [ -e "$ST/cpu-max4" ]; then   # eco was applied: undo exactly that, nothing else
            echo 1 > "$CPU/cpu7/online" 2>/dev/null
            _m=$(rd "$ST/cpu-max4"); [ -n "$_m" ] || _m=$(rd "$CPU/cpufreq/policy4/cpuinfo_max_freq")
            [ -z "$_m" ] || echo "$_m" > "$CPU/cpufreq/policy4/scaling_max_freq" 2>/dev/null
            rm -f "$ST/cpu-max4"
        fi
    fi
    return 0
}

# --- the state machine
set_state() { echo "$1" > "$ST/state"; echo "$2" > "$ST/reason"; say "$1: $2"; }
enter_idle() {  # enter_idle PROFILE REASON: LEDs, hotspot, modem, CPU - in that order
    _acted=1
    echo idle > "$ST/state"   # first: a TERM from here on must find "idle" and wake the radios
    [ "$(knob "$1" LEDS_IDLE)" = off ] && leds_idle on
    hotspot off
    modem_idle "$(knob "$1" RADIO_IDLE)"
    cpu "$(knob "$1" CPU)"
    set_state idle "$2"
}
leave_idle() {  # leave_idle REASON [fast]: the reverse order; fast (the exit trap) brings the hotspot up first
    _acted=1
    if [ "${2:-}" = fast ]; then hotspot on; leds_idle off; cpu full; modem_idle resume
    else cpu full; modem_idle resume; hotspot on; leds_idle off; fi
    rm -f "$ST/wake"
    uptime_s > "$ST/idle-since"
    set_state active "$1"   # last: a kill in the middle leaves "idle", and the next start-up or key finishes the wake
}
# --- the charging boot: LK opened our slot for a flat battery on the charger; stay light until the Wi-Fi key
boot_mode() { rd "$RUN/boot-mode"; }
enter_charging_boot() {
    echo charging-boot > "$ST/state"   # first, as enter_idle does: the retries need to know what the state wants
    touch "$RUN/charging-boot"         # init made it already; the Ubuntu units check it
    echo 0 > "$ST/low-loops"
    hotspot off
    modem_idle off
    mu300-led charge on 2>/dev/null || true
    set_state charging-boot "charging boot (LK boot mode charger)"
}
leave_charging_boot() {  # leave_charging_boot REASON
    mu300-led charge off 2>/dev/null || true
    rm -f "$RUN/charging-boot" "$ST/low-loops"
    is_openwrt || systemctl start mu300-mobile-data </dev/null 2>/dev/null || true   # skipped at boot by the flag
    leave_idle "$1"
}
low_battery_check() {  # unplugged and under 5 % for three loops in a row: a clean poweroff, not a brown-out
    _lowc=$(capacity)
    case $_lowc in ''|*[!0-9]*) echo 0 > "$ST/low-loops"; return 0 ;; esac
    if plugged || [ "$_lowc" -ge 5 ]; then echo 0 > "$ST/low-loops"; return 0; fi
    _lown=$(( $(num "$(rd "$ST/low-loops")") + 1 )); echo "$_lown" > "$ST/low-loops"
    [ "$_lown" -ge 3 ] || return 0
    say "battery at $_lowc % and unplugged for three loops: powering off"
    if is_openwrt; then poweroff; else systemctl poweroff </dev/null; fi
    return 0
}

# --- charging guard: temperature and the charge limit, through the charger's charge_type (bq256xx: N/A off, Fast on)
charging_switch() { _gc=$(charger_dir) && [ -f "$_gc/charge_type" ] && echo "$_gc/charge_type"; }
set_charging() {  # set_charging on|off REASON: compares with the node itself; $ST/charge-off is only the reason marker
    _sw=$(charging_switch) || return 0
    _cur=$(rd "$_sw")
    if [ "$1" = off ]; then
        if [ "$_cur" != 'N/A' ]; then
            if echo 'N/A' > "$_sw" 2>/dev/null; then say "charging off: $2"; else say "charging off: $2 - writing $_sw failed"; fi
        fi
        echo "$2" > "$ST/charge-off"
    else
        if [ "$_cur" = 'N/A' ]; then
            if echo Fast > "$_sw" 2>/dev/null; then say "charging on: $2"; else say "charging on: $2 - writing $_sw failed"; fi
        fi
        rm -f "$ST/charge-off"
    fi
    return 0
}
guard() {  # temp in 0.1 C: off above 45.0 or below 0, back on under 40.0 and over 3.0; CHARGE_TO=80: off at 80 %, on under 75
    charging_switch >/dev/null || { [ -e "$ST/no-switch-logged" ] || { say "no charge switch: the guard does nothing"; : > "$ST/no-switch-logged"; }; return 0; }
    _gt=$(battery_temp); _gcap=$(capacity); _goff=$(rd "$ST/charge-off")
    case $_goff in   # off for a reason whose reading is gone: fail safe, keep it off
        temp) case ${_gt#-} in ''|*[!0-9]*) return 0 ;; esac ;;
        limit) case $_gcap in ''|*[!0-9]*) return 0 ;; esac ;;
    esac
    _gwant=on _gwhy=
    case ${_gt#-} in ''|*[!0-9]*) ;; *)
        if [ "$_gt" -gt 450 ] || [ "$_gt" -lt 0 ]; then _gwant=off _gwhy=temp
        elif [ "$_goff" = temp ] && { [ "$_gt" -ge 400 ] || [ "$_gt" -le 30 ]; }; then _gwant=off _gwhy=temp; fi ;;
    esac
    if [ "$_gwant" = on ] && [ "$(conf_get CHARGE_TO)" = 80 ]; then
        case $_gcap in ''|*[!0-9]*) ;; *)
            if [ "$_gcap" -ge 80 ]; then _gwant=off _gwhy=limit
            elif [ "$_goff" = limit ] && [ "$_gcap" -ge 75 ]; then _gwant=off _gwhy=limit; fi ;;
        esac
    fi
    if [ "$_gwant" = off ]; then set_charging off "$_gwhy"; else set_charging on "back in range"; fi
}

step() {  # one look at the world; sets _acted when it changed the state
    mkdir -p "$ST"
    _prof=$(pick_profile); _state=$(rd "$ST/state")
    [ -n "$_state" ] || { _state=active; set_state active "started"; }
    _old=$(rd "$ST/profile"); echo "$_prof" > "$ST/profile"
    _now=$(num "$(uptime_s)")
    if activity; then echo "$_now" > "$ST/idle-since"; fi
    [ -s "$ST/idle-since" ] || echo "$_now" > "$ST/idle-since"
    case $_state in
        idle)
            rm -f "$ST/idle-now"
            if [ -e "$ST/wake" ]; then leave_idle "woken by a key"; return 0; fi
            if usb_host; then leave_idle "woken by a computer on USB"; return 0; fi
            if [ "$_prof" = plugged ]; then leave_idle "woken: plugged in"; return 0; fi
            if [ -n "$_old" ] && [ "$_old" != "$_prof" ]; then enter_idle "$_prof" "idle: profile now $_prof"; fi ;;
        charging-boot)   # only the Wi-Fi key ends it; a computer on USB does not
            rm -f "$ST/idle-now"
            low_battery_check
            if [ -e "$ST/wake" ]; then leave_charging_boot "woken by the Wi-Fi key"; fi ;;
        *)  # active; anything unknown is treated as active
            [ "$_state" = active ] || set_state active "unknown state '$_state'"
            if [ -e "$ST/wake" ]; then rm -f "$ST/wake"; echo "$_now" > "$ST/idle-since"; fi
            if [ -e "$ST/idle-now" ]; then rm -f "$ST/idle-now"; enter_idle "$_prof" "idle now (asked)"; return 0; fi
            _min=$(knob "$_prof" WIFI_IDLE)
            [ "$_min" = 0 ] && return 0
            _since=$(num "$(rd "$ST/idle-since")")
            if [ $((_now - _since)) -ge $((_min * 60)) ]; then enter_idle "$_prof" "idle: no client for $_min min ($_prof)"; fi ;;
    esac
    return 0
}
loop() {  # retries wait for a loop that changed nothing: a transition has just done its own actions
    _acted=
    guard
    step
    [ -n "$_acted" ] || retry_run
    return 0
}
cmd_daemon() {
    mkdir -p "$ST"
    if [ -z "${MU300_POWER_LOOPS:-}" ] || [ "${MU300_POWER_FRESH:-}" = 1 ]; then
        # start-up: /run is per boot, so a state found here is from this boot (a restarted daemon); keep it
        rm -f "$ST/idle-now"
        [ -s "$ST/idle-since" ] || uptime_s > "$ST/idle-since"
        # LK booted us for a flat battery on the charger: charging boot, but only when this boot has no state yet
        # (a daemon restarted after the key press keeps "active"; one restarted inside the charging boot keeps that)
        if [ ! -s "$ST/state" ] && [ "$(boot_mode)" = charger ]; then enter_charging_boot; fi
    fi
    _sleep=
    trap '[ -z "$_sleep" ] || kill "$_sleep" 2>/dev/null; if [ "$(rd "$ST/state")" = idle ]; then leave_idle "daemon stopping" fast; fi; exit 0' TERM INT
    _n=0
    while :; do
        loop
        _n=$((_n + 1))
        [ -n "${MU300_POWER_LOOPS:-}" ] && [ "$_n" -ge "$MU300_POWER_LOOPS" ] && break
        sleep "${MU300_POWER_INTERVAL:-10}" &
        _sleep=$!
        wait "$_sleep"
        _sleep=
    done
}
cmd_log() {  # cmd_log [SECONDS] [FILE]
    _lge=${1:-5}; _lgf=${2:-/var/log/mu300-power.csv}
    case $_lge in
        ''|*[!0-9]*) echo "usage: mu300-power log [SECONDS] [FILE]" >&2; return 2 ;;
        0*) [ "$_lge" -gt 0 ] || [ -n "${MU300_POWER_LOOPS:-}" ] || { echo "usage: mu300-power log [SECONDS>0] [FILE]" >&2; return 2; } ;;
    esac
    case $_lgf in */*) _lgd=${_lgf%/*} ;; *) _lgd=. ;; esac
    [ -d "${_lgd:-/}" ] || { echo "mu300-power: log: no directory $_lgd for $_lgf" >&2; return 1; }
    [ -s "$_lgf" ] || echo 'epoch,mV,mA,mW,capacity,temp,state,profile' > "$_lgf" || return 1
    _lgn=0
    while :; do
        _lgs=$(rd "$ST/state"); [ -n "$_lgs" ] || _lgs=active
        _lgp=$(rd "$ST/profile"); [ -n "$_lgp" ] || _lgp=$(pick_profile)
        if _lgb=$(battery_dir); then
            _lgv=$(( $(num "$(rd "$_lgb/voltage_now")") / 1000 )); _lga=$(( $(num "$(rd "$_lgb/current_now")") / 1000 ))
            echo "$(date +%s),$_lgv,$_lga,$(( _lgv * _lga / 1000 )),$(rd "$_lgb/capacity"),$(rd "$_lgb/temp"),$_lgs,$_lgp" >> "$_lgf"
        else
            echo "$(date +%s),,,,,,$_lgs,$_lgp" >> "$_lgf"
        fi
        _lgn=$((_lgn + 1)); [ -n "${MU300_POWER_LOOPS:-}" ] && [ "$_lgn" -ge "$MU300_POWER_LOOPS" ] && break
        sleep "$_lge"
    done
}
cmd_wake() { mkdir -p "$ST"; touch "$ST/wake"; }
cmd_idle() { mkdir -p "$ST"; touch "$ST/idle-now"; }

case "${1:-}" in
    status)  cmd_status ;;
    set)     shift; cmd_set "$@" ;;
    profile) shift; cmd_profile "$@" ;;
    wake)    cmd_wake ;;
    idle)    cmd_idle ;;
    daemon)  cmd_daemon ;;
    log)     shift; cmd_log "$@" ;;
    *) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
